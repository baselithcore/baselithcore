# ============================================================
# 🧱 BASE IMAGE
# ============================================================
# Digest-pinned: same Dockerfile at the same commit builds the same base.
# Refresh the digest deliberately when bumping the base image.
FROM python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    TOKENIZERS_PARALLELISM=false \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ------------------------------------------------------------
# 📦 System Dependencies
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget build-essential ca-certificates ssdeep libfuzzy-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ============================================================
# 🧠 INSTALLING PYTHON DEPENDENCIES
# ============================================================


# Torch CPU-only. Pinned to a matched pair (torch/torchvision must move
# together) so image builds are reproducible; kept in step with uv.lock and
# bumped deliberately. >=2.6 closes CVE-2025-32434 (torch.load RCE).
# torchaudio is not a dependency of anything shipped, so it is not installed.
RUN pip install --no-cache-dir \
    torch==2.13.0 torchvision==0.28.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Copy updated requirements and project metadata
COPY requirements.txt pyproject.toml README.md ./

# Install main dependencies (updated versions)
RUN pip install --no-cache-dir -r requirements.txt

# Installa Chromium headless usato da Playwright
# Install system deps for playwright
RUN apt-get update && \
    python -m playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# 🧠 PRE-CACHE LIGHT MODELS
# ============================================================
ENV HF_HOME=/app/models
RUN mkdir -p /app/models

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')" && \
    python -c "from sentence_transformers import CrossEncoder; CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

# ============================================================
# 📂 APP FILE COPY (Selective Copy)
# ============================================================
COPY backend.py .
# Alembic config + migration scripts: both `alembic upgrade head` (pre-deploy
# Job) and the in-app ensure_schema() fallback resolve them from /app.
COPY alembic.ini .
COPY migrations/ migrations/
COPY core/ core/
COPY plugins/ plugins/
COPY configs/ configs/
COPY scripts/ scripts/
COPY templates/ templates/

# Install the package itself in non-editable mode
RUN pip install .

# Create necessary directories if they don't exist (e.g. data, logs)
RUN mkdir -p data logs documents

# Precompile the app tree served from /app (uvicorn imports core/ and plugins/
# from the working directory, not from the pip-installed copy), so workers do
# not recompile it on every boot. checked-hash: valid regardless of mtimes,
# re-validated against the source, never stale under a bind mount.
RUN python -m compileall -q --invalidation-mode checked-hash \
    /app/backend.py /app/core /app/plugins

# ============================================================
# ⚙️ ENV DEFAULT
# ============================================================
ENV HOST=0.0.0.0 \
    PORT=8000 \
    WEB_CONCURRENCY=1 \
    QDRANT_MODE=embedded \
    OLLAMA_API_BASE=http://localhost:11434 \
    OLLAMA_MODEL=mistral:latest

# --- Create non-root user and volumes ---
RUN useradd --create-home --uid 1000 --shell /bin/bash appuser \
    && mkdir -p data logs documents models \
    && chown -R appuser:appuser /app /ms-playwright

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD sh -c 'curl -f "http://localhost:${PORT:-8000}/health" || exit 1'

# ============================================================
# 🚀 ENTRYPOINT
# ============================================================
# --proxy-headers + FORWARDED_ALLOW_IPS: without them request.client.host behind a
# load balancer is the proxy IP, collapsing per-IP rate limits and the admin
# lockout into ONE shared bucket. Trust is limited to the IPs listed in
# FORWARDED_ALLOW_IPS (uvicorn default 127.0.0.1); set it to your LB address(es).
# --no-server-header: drop the `Server: uvicorn` banner. nginx replaces it at
# the edge, but a pod behind a cloud LB / ingress that passes upstream headers
# through would otherwise advertise the exact server stack to every caller.
# --timeout-graceful-shutdown: bounded drain so SIGTERM with open SSE streams
# still runs lifespan cleanup before the orchestrator (e.g. k8s, 30s grace) SIGKILLs.
# WEB_CONCURRENCY: size to ~CPU cores in production; 1 worker means any CPU-bound
# work freezes the whole API. With WEB_CONCURRENCY>1 also set
# PROMETHEUS_MULTIPROC_DIR (e.g. /tmp/prometheus, mkdir'd at start) so /metrics
# aggregates across workers instead of answering per-process.
# --timeout-keep-alive: longer than any reverse proxy's upstream idle timeout
# (nginx/ALB/Envoy default 60s) so the proxy never reuses a socket uvicorn has
# already closed (sporadic 502s). See Dockerfile-full for the full rationale.
CMD ["sh", "-c", "exec uvicorn backend:app --host ${HOST:-0.0.0.0} --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-1} --proxy-headers --no-server-header --forwarded-allow-ips ${FORWARDED_ALLOW_IPS:-127.0.0.1} --timeout-graceful-shutdown ${GRACEFUL_SHUTDOWN_TIMEOUT:-25} --timeout-keep-alive ${UVICORN_KEEP_ALIVE:-75}"]
