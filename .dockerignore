.eggs/
.env
.env.*
!.env.example

# === Credentials (never part of a build context) ===
*.pem
*.key
*.p12
*.pfx
deploy/sandbox/client-certs/
# Operator-edited env templates. docker-compose loads them from the HOST via
# `env_file:` and the app never reads configs/.env.* at runtime, so nothing in
# the image needs them — and a filled-in .env.production must not end up in a
# layer that gets pushed to a registry.
configs/.env*

# === Virtual env ===
venv/
.env/
.venv/
ENV/

# === Log e temp ===
*.log
*.sqlite3
*.db
*.db-journal
.DS_Store
Thumbs.db

# === Git ===
.git/
.gitignore

# === Documentazione ===
/docs/site/
/docs/build/
/mkdocs.yml

# === Dati runtime (montati come volumi a runtime) ===
/data/
/qdrant_data/
/model_cache/
/feedback.db

# === Docker ===
# The Dockerfile is read separately from the context, and the compose files are
# host-side orchestration — none of them belong in a build layer.
Dockerfile
compose*.yaml
.dockerignore

# === Frontend & Build Artifacts ===
**/node_modules
frontend/dist
frontend/.vite
frontend/node_modules
# Plugin console build inputs. Both Dockerfiles `COPY plugins/ plugins/`, and
# only the compiled bundle (ui/dist, ui/out, ui/build) is served at runtime or
# hashed by the integrity check (core/plugins/integrity.py scopes ui/ the same
# way) — the TypeScript sources and tsc incremental state are pure build input
# that otherwise land in a pushed layer. Patterns are single-segment globs on
# purpose: plugins/<name>/ui/src, never a nested match. Plugin tests/ stay:
# they ARE part of the integrity hash, so dropping them would break signed
# plugins at load.
plugins/*/ui/src
plugins/*/ui/*.tsbuildinfo
# Source maps: the dashboards build with `sourcemap: 'hidden'`, which writes
# .map files for upload to an error tracker and strips the sourceMappingURL
# comment — so nothing in the running image would ever request them, and they
# would only sit in a pushed layer carrying the original TypeScript sources.
# Same exclusion as the wheel's [tool.setuptools.exclude-package-data].
plugins/*/ui/dist/**/*.map
# In-repo FIXTURES, not product. `example-plugin` is the scaffold the authoring
# guide walks through and `test-project` is the tree the plugin CLI tests
# scaffold against. `COPY plugins/ plugins/` shipped both into the runtime
# image, and configs/plugins.yaml had `example-plugin: enabled: true`, so the
# released container actually LOADED the demo plugin and registered its
# handlers and router into the production API gateway. They are excluded from
# the wheel the same way (see [tool.setuptools.packages.find] in
# pyproject.toml).
plugins/example-plugin/
plugins/test-project/
tests/
htmlcov/
.coverage
__pycache__/
docs/
examples/
