# EditorConfig — https://editorconfig.org
#
# The formatters in .pre-commit-config.yaml (ruff-format, prettier,
# markdownlint) are the authority on shipped files; this file is what stops an
# editor from fighting them BEFORE the hook runs. Every value below matches
# what those tools already enforce — it is not a second opinion, it is the same
# opinion expressed early enough for the editor to act on.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ruff-format: 4 spaces, 88 columns. E501 is ignored in the lint config because
# the formatter owns line length; max_line_length here is advisory for editors
# that draw a ruler.
[*.py]
indent_size = 4
max_line_length = 88

# prettier's defaults for the web tree and every config format.
[*.{js,jsx,ts,tsx,vue,mjs,cjs,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# markdownlint MD009 permits a two-space hard line break; stripping it would
# silently change rendering.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

# Tabs are syntax in a Makefile and in Go, not style.
[{Makefile,*.mk,go.mod}]
indent_style = tab

# ---------------------------------------------------------------------------
# Generated trees: byte-for-byte, so an editor must add nothing at all.
# ---------------------------------------------------------------------------
# A plugin's shipped SPA bundle has two owners that both compare it exactly:
# the `ui_build` CI gate rebuilds it from a clean `npm ci` and diffs, and
# ui/dist/** is inside the plugin-integrity hash surface, so one rewritten byte
# invalidates the manifest's integrity_sha256 and the plugin stops loading
# under BASELITH_REQUIRE_SIGNED_PLUGINS. vite writes its .js.map files with no
# trailing newline; adding one is exactly the drift that cost a green CI once
# (see the end-of-file-fixer exclusion in .pre-commit-config.yaml).
[plugins/*/ui/{dist,out,build}/**]
insert_final_newline = false
trim_trailing_whitespace = false

# Regenerated by scripts/export_openapi.py and diffed by the openapi_drift
# gate. What the exporter writes is the only correct content.
[{sdk/openapi.json,mkdocs-site/docs/api/specs/openapi.json}]
insert_final_newline = false
trim_trailing_whitespace = false

# Written by `uv lock`; `uv lock --check` is a CI job.
[uv.lock]
insert_final_newline = false
trim_trailing_whitespace = false
