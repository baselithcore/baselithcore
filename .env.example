# BaselithCore — environment template
# Copy to .env and fill in REAL values. NEVER commit .env (gitignored).
# All secrets MUST be rotated if exposed.

# ── Core ──────────────────────────────────────────────────────────────────
# Runtime environment. Gates every fail-closed control: plugin signature
# enforcement, unsigned-A2A rejection, the A2A SSRF internal-host deny, admin
# lockout on Redis loss, the JWT issuer/audience startup check and anonymous
# /docs. "prod", "prd" and "live" all count as production. A name matching
# neither the production aliases nor a known non-production one (development,
# dev, local, test, ci, staging, qa, uat, sandbox, demo, preview, preprod,
# nonprod, ...) is treated as production — declare a known name to opt out.
APP_ENV=development
CORE_APP_NAME=baselith-core
CORE_DEBUG=false
CORE_MAX_WORKERS=4
CORE_PLUGIN_DIR=./plugins
CORE_DATA_DIR=./data
CORE_DOCUMENTS_DIR=./documents
CORE_DETERMINISTIC_MODE=false
CORE_RANDOM_SEED=42
PORT=8000

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_API_KEY=__CHANGE_ME__
LLM_API_BASE=
# Dedicated Ollama endpoint. Set this when Ollama is NOT the default provider
# above but a per-plugin LLM policy pins some plugin to it: LLM_API_BASE belongs
# to the default provider, and handing it to Ollama would aim those calls at the
# wrong server. Falls back to LLM_API_BASE (only when LLM_PROVIDER=ollama), then
# OLLAMA_HOST, then http://localhost:11434.
LLM_OLLAMA_API_BASE=
# Per-provider keys for the per-plugin LLM policy. LLM_API_KEY belongs to
# LLM_PROVIDER; a plugin pinned to another provider is served by that
# provider's dedicated key. Blank = provider reported as not configured.
LLM_ANTHROPIC_API_KEY=
LLM_HUGGINGFACE_API_KEY=
LLM_ENABLE_CACHE=true
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_SIZE=1000
LLM_HUGGINGFACE_LOCAL=false
LLM_HUGGINGFACE_DEVICE=cpu
LLM_HUGGINGFACE_DTYPE=float16
LLM_HUGGINGFACE_TRUST_REMOTE_CODE=false
HF_TOKEN=__CHANGE_ME__
# Google Gemini (optional extra: pip install "baselith-core[gemini]")
# LLM_GEMINI_API_KEY=__CHANGE_ME__
# Cross-provider fallback chain (ordered "provider:model" pairs; empty = off)
# LLM_FALLBACK_CHAIN=openai:gpt-4o-mini,ollama:llama3.2
# Per-stage bound for the chain above. Unset, every stage may spend the full
# LLM_REQUEST_TIMEOUT, so a chain ending at a slow local model can hold one HTTP
# request open for minutes — long past the point a reverse proxy gave up and the
# caller decided the plugin was dead. Set it below the proxy's read timeout.
# LLM_FALLBACK_STAGE_TIMEOUT=45
# Wall-clock ceiling for the WHOLE chain. Unset means LLM_REQUEST_TIMEOUT.
# This is what bounds the chain when no per-stage timeout is set: each stage
# may spend the request timeout across its retries plus backoff, so three
# stages run for many minutes. Stages that no longer fit are skipped.
# LLM_FALLBACK_TOTAL_TIMEOUT=120
# Cost-aware model routing by task category (see core/models/routing.py)
# LLM_ROUTING_ENABLED=false
# LLM_ROUTING_POLICY={"planning": "gpt-4o", "classification": "gpt-4o-mini"}

# ── Vision ────────────────────────────────────────────────────────────────
VISION_PROVIDER=openai
VISION_OPENAI_API_KEY=__CHANGE_ME__
VISION_ANTHROPIC_API_KEY=__CHANGE_ME__
VISION_GOOGLE_API_KEY=__CHANGE_ME__
VISION_OLLAMA_HOST=http://localhost:11434
VISION_OLLAMA_MODEL=llava

# ── Voice ─────────────────────────────────────────────────────────────────
VOICE_PROVIDER=openai
VOICE_OPENAI_API_KEY=__CHANGE_ME__
VOICE_ELEVENLABS_API_KEY=__CHANGE_ME__
VOICE_GOOGLE_API_KEY=__CHANGE_ME__
VOICE_GOOGLE_APPLICATION_CREDENTIALS=

# ── Anthropic / Fine-tuning ───────────────────────────────────────────────
ANTHROPIC_API_KEY=__CHANGE_ME__
FINETUNE_OPENAI_API_KEY=__CHANGE_ME__
FINETUNE_TOGETHER_API_KEY=__CHANGE_ME__

# ── Vector store (Qdrant) ─────────────────────────────────────────────────
VECTORSTORE_PROVIDER=qdrant
VECTORSTORE_COLLECTION_NAME=baselith
VECTORSTORE_QDRANT_HOST=localhost
VECTORSTORE_PORT=6333
VECTORSTORE_GRPC_PORT=6334
VECTORSTORE_EMBEDDING_MODEL=text-embedding-3-small
VECTORSTORE_EMBEDDING_DIM=1536
EMBEDDING_CACHE_TTL=86400
VECTORSTORE_SEARCH_LIMIT=10
VECTORSTORE_QDRANT_MODE=server
# Deadline on every vector store request (seconds): a hung Qdrant fails fast
# into the retry/breaker wrappers instead of stalling callers.
# VECTORSTORE_TIMEOUT_SECONDS=30.0
# Managed/remote Qdrant only — leave unset for the local compose default.
# QDRANT_API_KEY=
# QDRANT_HTTPS=false

# ── Chat ──────────────────────────────────────────────────────────────────
CHAT_STREAMING_ENABLED=true
CHAT_INITIAL_SEARCH_K=20
CHAT_FINAL_TOP_K=5
CHAT_MAX_HISTORY_LENGTH=20
CHAT_ENABLE_RERANKING=false
CHAT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHAT_RERANK_MAX_CANDIDATES=20
CHAT_ENABLE_RESPONSE_CACHE=true
CHAT_RESPONSE_CACHE_TTL=300
# Pre-retrieval answer cache (opt-in). Probed right after history load, keyed
# WITHOUT the retrieved context, so a hit skips vector search, cross-encoder
# rerank and context building — not just LLM generation.
# TRADE-OFF: that key cannot see a corpus change through the query alone. The
# indexing service's index_version is folded into the key, which invalidates
# on an in-process reindex, but a reindex performed by ANOTHER process is
# invisible here — the short TTL below is the only defense in that case.
# Leave false unless you accept answers up to CHAT_RAG_PRECHECK_TTL seconds
# stale. Keys live in their own namespace and can be flushed independently of
# the response cache. See docs/core-modules/chat.md.
CHAT_RAG_PRECHECK_ENABLED=false
CHAT_RAG_PRECHECK_TTL=60
CHAT_RAG_PRECHECK_MAXSIZE=256

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_ENABLED=true
# Run Alembic migrations inside the app lifespan at boot (single-node default).
# Set false when a pre-deploy migration Job runs them (the Helm chart does
# this automatically when migrations.enabled=true).
DB_MIGRATIONS_ON_STARTUP=true
# Rate-limiter behavior when Redis is unreachable: open = per-process fallback
# (limit silently becomes ~N x across replicas), closed = reject with 503.
RATE_LIMIT_FAIL_MODE=open
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baselith
DB_USER=baselith
DB_PASSWORD=__CHANGE_ME__
DB_SSL_MODE=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30

# ── Graph DB ──────────────────────────────────────────────────────────────
GRAPH_DB_ENABLED=false
GRAPH_DB_URL=bolt://localhost:7687
GRAPH_DB_NAME=neo4j
GRAPH_RAG_ENABLED=false
GRAPH_DB_TIMEOUT=30
GRAPH_SIMILAR_TOP_K=5
GRAPH_CACHE_TTL=3600
GRAPH_QUERY_LIMIT=100
GRAPH_MAX_HOPS=3
GRAPH_QUERY_TIMEOUT=10

# ── Cache / Queue (Redis) ─────────────────────────────────────────────────
CACHE_BACKEND=redis
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_PREFIX=baselith:
QUEUE_REDIS_URL=redis://localhost:6379/1
# XFetch probabilistic early refresh (cache-stampede prevention): as an entry
# nears expiry one caller treats a hit as a miss and recomputes before the TTL
# lapses, so the herd never meets a synchronised cold key. 1.0 is the canonical
# value and the default; 0 disables; >1 recomputes earlier, <1 later.
BASELITH_CACHE_XFETCH_BETA=1.0
# Cross-worker single-flight (opt-in, default false). With WEB_CONCURRENCY>1 or
# several pods, in-process coalescing still lets N workers issue N identical
# LLM/embedding calls for one key. Enabling this elects ONE worker per key via a
# Redis lock; the others read the winner's value back out of the shared cache.
# Only takes effect where the backing cache is genuinely shared (Redis) — over a
# process-local store the loser has nothing to re-read. Fail-open: if Redis is
# unreachable the path degrades to in-process coalescing, never to an error.
CACHE_CROSS_WORKER_SINGLE_FLIGHT=false

# ── Document ingestion ────────────────────────────────────────────────────
DOCUMENTS_EXTENSIONS=pdf,docx,txt,md
WEB_DOCUMENTS_ENABLED=false
WEB_DOCUMENTS_URLS=
WEB_DOCUMENTS_MAX_PAGES=50
WEB_DOCUMENTS_MAX_DEPTH=2
WEB_DOCUMENTS_RENDER_TIMEOUT=30
WEB_DOCUMENTS_USER_AGENT=baselith-core/1.0
WEB_DOCUMENTS_ALLOWLIST=
ENABLE_SPACY_DOCUMENTS=false
SPACY_MODEL=en_core_web_sm
SPACY_FALLBACK_LANGUAGE=en

# ── OCR ───────────────────────────────────────────────────────────────────
# Backends: auto | mineru | tesseract. MinerU is the DEFAULT (primary) backend
# and requires the extra:  pip install -e ".[mineru]"  (heavy; downloads models
# on first use — pre-fetch with `mineru-models-download`). When MinerU is
# selected but not installed, OCR falls back to tesseract automatically. Set
# this to `tesseract` to avoid pulling the mineru/transformers stack entirely.
PDF_OCR_BACKEND=mineru
# MinerU engine: pipeline (CPU-ok) | vlm-engine | hybrid-engine |
# vlm-http-client | hybrid-http-client
MINERU_BACKEND=pipeline
# OCR language model: en/latin cover Latin-script languages (incl. Italian);
# others: ch, korean, japan, th, el, arabic, cyrillic, devanagari, ...
MINERU_LANG=en
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
# Remote inference server for *-http-client backends (e.g. http://mineru:30000)
MINERU_SERVER_URL=
# Model download source: huggingface | modelscope | local (empty = auto)
MINERU_MODEL_SOURCE=
# Untrusted-document guards (documents may arrive from the web crawler).
# 0 disables an individual cap. Oversized/too-long input is skipped before the
# heavy parse; parses run on a dedicated bounded pool with a wall-clock timeout.
MINERU_MAX_BYTES=52428800
MINERU_MAX_PAGES=500
MINERU_TIMEOUT_SECONDS=300
MINERU_MAX_CONCURRENCY=2

# ── Logging / Telemetry ───────────────────────────────────────────────────
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG
LOG_JSON=true
LOG_MASKING_ENABLED=true
# Directory for the JSON file sink (app.log). Empty ⇒ CWD-relative "logs/".
# Pin an ABSOLUTE path so the sink does not depend on the process working dir
# and lands on a writable, log-shipper-mounted volume (a Promtail scrape path,
# or a systemd ReadWritePaths dir under ProtectSystem=strict).
#   BASELITH_LOG_DIR=/var/log/baselithcore
BASELITH_LOG_DIR=
TELEMETRY_ENABLED=true
# gRPC OTLP endpoint (the exporter is gRPC: port 4317, NOT 4318/HTTP).
TELEMETRY_OTEL_ENDPOINT=http://localhost:4317
# With WEB_CONCURRENCY>1 set PROMETHEUS_MULTIPROC_DIR (an existing writable
# dir, e.g. /tmp/prometheus) so /metrics aggregates across uvicorn workers.
#   PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
APP_TIMEZONE=UTC

# ── Features ──────────────────────────────────────────────────────────────
ENABLE_FEEDBACK=true
# Document-feedback boost on the RAG path. The rollup scans up to
# FEEDBACK_ANALYTICS_DOC_SCAN_LIMIT rows and aggregates them in Python on every
# request, so it is cached per (tenant, min_total) for this many seconds.
# 0 disables the cache and recomputes on every request.
# FEEDBACK_SUMMARY_CACHE_TTL=60
LLM_BUDGET_ENABLED=true
LLM_BUDGET_MAX_TOKENS=1000000
# Per-process cap on concurrent LLM provider calls (streams hold a slot for
# their whole duration). 0 = unlimited.
# LLM_MAX_CONCURRENT_REQUESTS=0
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_MAX_TURNS=10
CHAT_MEMORY_SUMMARY_ENABLED=true
CHAT_GUARDRAILS_ENABLED=true
CHAT_GUARDRAILS_BLOCK_MESSAGE=Content blocked by guardrails.
CHAT_GUARDRAILS_OUT_OF_SCOPE_MESSAGE=Out-of-scope request rejected.

# ── Supermemory (optional intelligent memory backend) ─────────────────────
# SUPERMEMORY_ENABLED=false
# SUPERMEMORY_API_KEY=
# SUPERMEMORY_BASE_URL=
# SUPERMEMORY_DEFAULT_TAG=baselithcore_default
# SUPERMEMORY_SEARCH_LIMIT=5
# SUPERMEMORY_MIN_SCORE=0.0
# Per-request timeout (seconds) and SDK retry budget: without a timeout an
# unresponsive endpoint would stall memory operations indefinitely.
# SUPERMEMORY_TIMEOUT_SECONDS=10.0
# SUPERMEMORY_MAX_RETRIES=2

# ── Plugins ───────────────────────────────────────────────────────────────
PLUGIN_ENABLED=true
PLUGIN_AUTO_LOAD=true
PLUGIN_CONFIG_PATH=./configs/plugins.yaml

# ── Swarm ─────────────────────────────────────────────────────────────────
# Maximum sub-tasks executed CONCURRENTLY inside one swarm handle(). Each
# sub-task is a full LLM call, so an unbounded fan-out over a large
# decomposition opens that many simultaneous provider calls (429 storm plus an
# ungated cost spike). The per-request loop budget still caps the TOTAL number
# of sub-tasks; this caps how many are in flight at once.
SWARM_MAX_CONCURRENT_SUBTASKS=5

# Threads in the dedicated model-inference pool (embedding, cross-encoder
# reranking). Kept separate from the interpreter default pool so a burst of
# inference cannot starve the short latency-critical tasks that share it —
# SSRF DNS resolution, audit-log appends, tokenization. Small on purpose: the
# inference libraries parallelise internally, so extra threads buy contention
# rather than throughput. Unset = min(4, cpu_count // 2).
BASELITH_INFERENCE_THREADS=

# ── Browser agent ─────────────────────────────────────────────────────────
# Lifetime of a cached per-host SSRF verdict. A cached verdict is a decision
# taken from a PAST DNS answer, so its lifetime is exactly the DNS-rebinding
# window; verdicts are also dropped on every top-level navigation, but that
# alone never expires them on a single-page app. 0 disables caching entirely
# (strictest: every request re-resolves, at one DNS lookup per sub-resource).
# NOTE: the in-process guard cannot close the rebinding window — Chromium
# resolves independently of this check. Route the browser through an
# egress-filtering proxy, or run it in a network namespace that denies
# internal ranges, if you need that guarantee.
BASELITH_BROWSER_SSRF_CACHE_TTL=30
# Escape hatch for trusted local development ONLY: allows the browser to reach
# loopback/private/link-local hosts.
BASELITH_BROWSER_ALLOW_INTERNAL=false

# ── Sandbox ───────────────────────────────────────────────────────────────
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=30
SANDBOX_ENABLE_NETWORK=false

# ── Tree-of-Thoughts ──────────────────────────────────────────────────────
TOT_MAX_DEPTH=4
TOT_BRANCHING_FACTOR=3
TOT_BEAM_WIDTH=3
TOT_STRATEGY=bfs
TOT_SELF_CORRECTION_MAX_ITERATIONS=2
TOT_THOUGHT_CACHE_MAXSIZE=1000
TOT_THOUGHT_CACHE_TTL=3600

# ── Resilience ────────────────────────────────────────────────────────────
RESILIENCE_CB_FAIL_MAX=5
RESILIENCE_CB_RESET_TIMEOUT=60
RESILIENCE_CB_HALF_OPEN_MAX=3
RESILIENCE_RETRY_MAX_ATTEMPTS=3
RESILIENCE_RETRY_BASE_DELAY=0.5
RESILIENCE_RETRY_MAX_DELAY=10
RESILIENCE_RETRY_EXPONENTIAL_BASE=2
RESILIENCE_RETRY_JITTER=0.1
RESILIENCE_BULKHEAD_MAX_CONCURRENT=10
RESILIENCE_API_RATE_LIMIT=100
RESILIENCE_API_RATE_WINDOW=60
RESILIENCE_LLM_RATE_LIMIT=20
RESILIENCE_LLM_RATE_WINDOW=60

# ── Auth / Security ───────────────────────────────────────────────────────
# SECRET_KEY MUST be >= 32 random bytes. Generate with: openssl rand -hex 32
AUTH_REQUIRED=true
SECRET_KEY=__CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32__
ALLOW_ORIGINS=https://app.example.com
# Host allowlist. Empty (the default) means TrustedHostMiddleware is NOT
# mounted and the Host header goes unvalidated — a spoofed Host then poisons
# absolute URLs built from the request (reset / verification links) and
# host-keyed caches. Production logs an ERROR at startup while this is empty.
TRUSTED_HOSTS=["app.example.com"]
# Per-source-IP budget for *failed* authentication attempts within
# RATE_LIMIT_WINDOW_SECONDS. Successful auth never touches this counter, so it
# throttles credential brute-force / stuffing without penalising a mistyped
# token. Blank disables it (not recommended: authenticated routes then accept
# an unmetered stream of rejected credentials).
AUTH_FAILURE_LIMIT_PER_MINUTE=20
API_KEYS_USER=__CHANGE_ME__
API_KEYS_ADMIN=__CHANGE_ME__
API_KEYS_JOB=__CHANGE_ME__
# Master switch for API-key auth. When false, API keys are rejected entirely.
API_KEY_ENABLED=true
ADMIN_USER=admin
ADMIN_PASS=__CHANGE_ME__
# Require admin basic auth on GET /metrics (disable only when the endpoint is
# reachable solely from the scrape network, e.g. behind a NetworkPolicy).
METRICS_AUTH_REQUIRED=true
# Autonomy level for MCPServer when no explicit policy is passed:
# supervised | semi_autonomous | fully_autonomous. MCP transports have no
# human-approval channel, so gated tool categories are rejected (fail-closed).
# Set fully_autonomous only when the MCP client enforces human approval
# (e.g. Claude Desktop tool prompts).
MCP_AUTONOMY_LEVEL=supervised
SENTRY_DSN=

# Plugin integrity: NEVER enable in production
BASELITH_SKIP_INTEGRITY_CHECK=false
# Reject any plugin that does not declare an integrity hash.
BASELITH_REQUIRE_SIGNED_PLUGINS=false
# Publisher authenticity: refuse plugins whose integrity hash is not Ed25519-
# signed by a trust root. Sign with scripts/sign_plugin_ed25519.py; generate
# keys with `python scripts/sign_plugin_ed25519.py keygen`.
BASELITH_REQUIRE_PLUGIN_SIGNATURES=false
# Comma-separated hex Ed25519 public keys trusted to sign plugins.
BASELITH_PLUGIN_TRUST_ROOTS=

# ── Agent-to-Agent (A2A) ──────────────────────────────────────────────────
# HMAC-sign A2A traffic: set the SAME secret on every peer of the mesh. When
# set, requests with a missing/invalid/stale signature are rejected with 401.
BASELITH_A2A_SHARED_SECRET=
# With no shared secret the A2A dispatch endpoint FAILS CLOSED in production
# (unsigned requests -> 401). Set true ONLY to explicitly allow unauthenticated
# A2A in production (trusted network). No effect outside production.
BASELITH_A2A_ALLOW_UNAUTHENTICATED=false
# Per-source-IP budget on POST /a2a, metered before signature verification with
# the same limiter the HTTP API uses (429 + Retry-After once exhausted).
# Default 120/min; 0 disables.
BASELITH_A2A_RATE_LIMIT_PER_MINUTE=120
# Maximum accepted JSON-RPC request body on POST /a2a (413 above it). The body
# is buffered to verify the signature over the exact bytes, so this bounds the
# read. Default 1 MiB; 0 disables.
BASELITH_A2A_MAX_BODY_BYTES=1048576
# Whether the SSRF guard lets A2A reach private/loopback/link-local peers.
# Unset, the default is environment-aware: allowed in development (meshes
# commonly run peers on internal networks) but DENIED in production, so a peer
# endpoint cannot be steered at cloud metadata (169.254.169.254), Redis or
# Postgres. Setting it overrides in both directions — true to opt a
# private-mesh production deployment back in, false to lock down a dev box.
A2A_ALLOW_INTERNAL_ENDPOINTS=

# ── Red Agent (security testing) ──────────────────────────────────────────
RED_AGENT_CA_CERT_PATH=
RED_AGENT_CA_KEY_PATH=
RED_AGENT_LLM_TRIAGE_ENABLED=false
RED_AGENT_LLM_TRIAGE_MODEL=
RED_AGENT_SEMANTIC_DEDUP_ENABLED=false
RED_AGENT_BUG_BOUNTY_MODE=false

# ── Backstage catalog / TechDocs source resolution ────────────────────────
# The Backstage exporter advertises each plugin's docs via a techdocs-ref in
# ONE of two modes. Pick the one that matches your deploy topology.
#
# GIT mode (default): the exporter emits an "url:" ref under this base, and the
# portal's TechDocs generator fetches the plugin's mkdocs from the git host.
# The public repo below needs no token; a PRIVATE fork would need a GITHUB_TOKEN
# integration in the portal app-config AND the docs pushed to the referenced
# branch — otherwise the Docs tab 404s (api.github.com/repos/.../status 404).
BASELITH_CATALOG_SOURCE_LOCATION=url:https://github.com/baselithcore/baselithcore/blob/main/
#
# LOCAL mode (self-hosted single-host deploy where the framework backend and the
# portal share the repo filesystem): set this to the ABSOLUTE repo root on that
# host. The exporter then emits "techdocs-ref: dir:." + a "file:" location, so
# the portal's generator builds docs straight from local disk — no git host,
# token or push needed. Leave EMPTY to stay in git mode above.
#   BASELITH_CATALOG_LOCAL_ROOT=/opt/baselithcore
BASELITH_CATALOG_LOCAL_ROOT=
