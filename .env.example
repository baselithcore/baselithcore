# BaselithCore — environment template
# Copy to .env and fill in REAL values. NEVER commit .env (gitignored).
# All secrets MUST be rotated if exposed.
#
# This file is NOT the manual. Every setting has a default, so only three kinds
# of line live here: credentials you must supply, values this template
# deliberately sets away from the code default, and flags whose wrong value is a
# security incident. The other ~450 settings — names, types, defaults and what
# they do — are in the generated reference:
#
#   mkdocs-site/docs/getting-started/configuration.md   (docs: Getting Started -> Configuration)
#
# `baselith config env` reports variables here that bind nothing.

# ── Core ──────────────────────────────────────────────────────────────────
# Runtime environment. Gates every fail-closed control: plugin signature
# enforcement, unsigned-A2A rejection, the A2A SSRF internal-host deny, admin
# lockout on Redis loss, the JWT issuer/audience startup check and anonymous
# /docs. "prod", "prd" and "live" all count as production. A name matching
# neither the production aliases nor a known non-production one (development,
# dev, local, test, ci, staging, qa, uat, sandbox, demo, preview, preprod,
# nonprod, ...) is treated as production — declare a known name to opt out.
APP_ENV=development
CORE_APP_NAME=baselith-core

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_API_KEY=__CHANGE_ME__
LLM_API_BASE=
# Dedicated Ollama endpoint. Set this when Ollama is NOT the default provider
# above but a per-plugin LLM policy pins some plugin to it: LLM_API_BASE belongs
# to the default provider, and handing it to Ollama would aim those calls at the
# wrong server. Falls back to LLM_API_BASE (only when LLM_PROVIDER=ollama), then
# OLLAMA_HOST, then http://localhost:11434.
LLM_OLLAMA_API_BASE=
# Self-hosted vLLM (LLM_PROVIDER=vllm, a policy pin, or a vllm:<model> chain
# stage). The endpoint is REQUIRED — no default, since vLLM's :8000 is also this
# backend's port; /v1 is appended when missing. The key is the server's
# --api-key (VLLM_API_KEY also honoured); leave empty for a keyless server. Set
# LLM_VLLM_NATIVE_TOOLS=false unless the server runs --enable-auto-tool-choice.
# LLM_VLLM_API_BASE=http://gpu-host:8000/v1
# Several vLLM servers, one per model: list them all; calls name a MODEL and go
# to the server whose /v1/models serves it (pins never name a port).
# LLM_VLLM_ENDPOINTS=http://gpu-host:8002/v1,http://gpu-host:8003/v1
# LLM_VLLM_API_KEY=
# LLM_VLLM_NATIVE_TOOLS=true
LLM_ANTHROPIC_API_KEY=
LLM_HUGGINGFACE_API_KEY=
LLM_HUGGINGFACE_DEVICE=cpu
LLM_HUGGINGFACE_DTYPE=float16
HF_TOKEN=__CHANGE_ME__
# Google Gemini (optional extra: pip install "baselith-core[gemini]")
# LLM_GEMINI_API_KEY=__CHANGE_ME__
# LLM_FALLBACK_CHAIN=openai:gpt-4o-mini,ollama:llama3.2
# A chain is a promise about an OUTAGE, not about a misconfiguration: a
# rejected request (expired key, unknown model, malformed payload) never falls
# through, or a lapsed hosted credential would quietly turn into permanent
# local inference that answers every request successfully. When a stage does
# serve, it is counted (mas_llm_fallback_served_total) and logged — alert on
# that counter, because the request still returns 200.
# Per-stage bound for the chain above. Unset, every stage may spend the full
# LLM_REQUEST_TIMEOUT, so a chain ending at a slow local model can hold one HTTP
# request open for minutes — long past the point a reverse proxy gave up and the
# caller decided the plugin was dead. Set it below the proxy's read timeout.
# LLM_FALLBACK_STAGE_TIMEOUT=45
# Wall-clock ceiling for the WHOLE chain. Unset means LLM_REQUEST_TIMEOUT.
# This is what bounds the chain when no per-stage timeout is set: each stage
# may spend the request timeout across its retries plus backoff, so three
# stages run for many minutes. Stages that no longer fit are skipped.
# LLM_FALLBACK_TOTAL_TIMEOUT=120
# Startup posture check (core/services/llm/preflight.py). Validates the
# provider, the chain's credentials and every LOCAL endpoint/model before the
# first request; it never calls a hosted provider. 'auto' fails startup in a
# production environment and warns elsewhere. The case it exists for: a
# deployment that never set LLM_PROVIDER inherits the package default and
# serves from whatever model is installed on the host, with no other symptom.
# LLM_PREFLIGHT=auto
# Cost-aware model routing by task category (see core/models/routing.py)
# LLM_ROUTING_ENABLED=false
# LLM_ROUTING_POLICY={"planning": "gpt-4o", "classification": "gpt-4o-mini"}
# Optional per-1K-token USD cap; a pricier routed model is swapped for one that fits
# LLM_ROUTING_MAX_COST_PER_1K_USD=0.01

# ── Vision ────────────────────────────────────────────────────────────────
VISION_OPENAI_API_KEY=__CHANGE_ME__
VISION_ANTHROPIC_API_KEY=__CHANGE_ME__
VISION_GOOGLE_API_KEY=__CHANGE_ME__

# ── Voice ─────────────────────────────────────────────────────────────────
VOICE_OPENAI_API_KEY=__CHANGE_ME__
VOICE_ELEVENLABS_API_KEY=__CHANGE_ME__
VOICE_GOOGLE_API_KEY=__CHANGE_ME__
VOICE_GOOGLE_APPLICATION_CREDENTIALS=

# ── Anthropic / Fine-tuning ───────────────────────────────────────────────
ANTHROPIC_API_KEY=__CHANGE_ME__
FINETUNE_OPENAI_API_KEY=__CHANGE_ME__
FINETUNE_TOGETHER_API_KEY=__CHANGE_ME__

# ── Vector store (Qdrant) ─────────────────────────────────────────────────
VECTORSTORE_COLLECTION_NAME=baselith
VECTORSTORE_EMBEDDING_MODEL=BAAI/bge-m3
VECTORSTORE_EMBEDDING_DIM=1024
VECTORSTORE_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_EMBEDDING_FALLBACK_DIM=384
EMBEDDING_CACHE_TTL=86400
# Deadline on every vector store request (seconds): a hung Qdrant fails fast
# into the retry/breaker wrappers instead of stalling callers.
# VECTORSTORE_TIMEOUT_SECONDS=30.0
# Managed/remote Qdrant only — leave unset for the local compose default.
# QDRANT_API_KEY=
# QDRANT_HTTPS=false
# pgvector HNSW tuning (VECTORSTORE_PROVIDER=pgvector). Defaults are pgvector's
# own. m/ef_construction are baked into the index at CREATE time — raising them
# on a populated collection needs the index dropped and rebuilt. ef_search is a
# per-query knob (applied as SET LOCAL); 0 leaves the server default alone.
# VECTORSTORE_HNSW_M=16
# VECTORSTORE_HNSW_EF_CONSTRUCTION=64
# VECTORSTORE_HNSW_EF_SEARCH=40
# Record gen_ai.usage.input_tokens on embedding spans. Off by default: it costs
# a second tokenizer pass over every text that misses the embedding cache.
# VECTORSTORE_EMBEDDING_TOKEN_USAGE_ENABLED=false
# Vector search result cache (Redis). Keyed per tenant, full query vector,
# filters and — when re-ranking — the question, so a hit is never another
# query's rows. Disable it, or shorten the TTL, when the collection changes
# faster than results should be reused.
# VECTORSTORE_SEARCH_CACHE_ENABLED=true
# VECTORSTORE_SEARCH_CACHE_TTL=300

# ── Chat ──────────────────────────────────────────────────────────────────
CHAT_MAX_HISTORY_LENGTH=20
CHAT_ENABLE_RERANKING=false
CHAT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHAT_RERANK_MAX_CANDIDATES=20
CHAT_RESPONSE_CACHE_TTL=300
# Wall-clock cap on one POST /chat/stream SSE response. A hung provider
# otherwise holds the connection — and the worker slot behind it — open
# indefinitely; on expiry the stream closes with its terminal `event: done`.
# Keep it below the reverse proxy's read timeout (the k8s overlay uses 300).
# CHAT_STREAM_TIMEOUT_SECONDS=300

# ── Orchestrator: durable checkpointing / human-in-the-loop ───────────────
# ORCHESTRATOR_CHECKPOINT_SQLITE_PATH=data/checkpoints.db

# Where effectful tool calls are recorded, so a redelivered task or a resumed
# run does not repeat a payment or an outbound webhook. `auto` uses Postgres
# when POSTGRES_ENABLED and warns when it falls back to the in-process ledger,
# which cannot deduplicate across replicas or restarts. Set `postgres` to
# refuse that fallback; `memory` for a single worker; `off` to record nothing.
# ORCHESTRATOR_TOOL_LEDGER=auto

# ── Orchestrator: agent-loop runtime caps ─────────────────────────────────
# Per-request ceilings every orchestrated run inherits. 0 disables a cap.
# ORCHESTRATOR_LOOP_MAX_TOKENS=400000
# ORCHESTRATOR_LOOP_MAX_SECONDS=600
# Denominator of token_pressure() when no token cap is set.
# ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=200000

# ── Orchestrator: background crash-recovery sweeps ────────────────────────
# Active only with ORCHESTRATOR_CHECKPOINT_RESUME_ON_STARTUP=true.
# ORCHESTRATOR_RECOVERY_SWEEP_INTERVAL_SECONDS=300
# How long a 'running' run must be silent before the sweep re-enters it.
# Recent progress means a worker still owns it; resuming anyway would run the
# same agent loop twice. Keep at or above the sweep interval.
# ORCHESTRATOR_RECOVERY_RESUME_AFTER_SECONDS=300
# ORCHESTRATOR_RECOVERY_STALE_AFTER_SECONDS=1800

# ── Orchestrator: tool burst rate limit (opt-in) ──────────────────────────
# ORCHESTRATOR_TOOL_RATE_LIMIT_ENABLED=true
# ORCHESTRATOR_TOOL_RATE_LIMIT_MAX_CALLS=30
# ORCHESTRATOR_TOOL_RATE_LIMIT_WINDOW_SECONDS=60

# ── Human-in-the-loop: callback thread pool ───────────────────────────────
# Blocking HITL callbacks run on a dedicated pool, never the interpreter
# default one — a callback waits on a person and a timed-out one never
# returns its thread.
# ORCHESTRATOR_HITL_CALLBACK_THREADS=8

# ── Crew: bounded parallel fan-out ────────────────────────────────────────
# Maximum crew tasks (each a full LLM call) running at once under
# process="parallel".
# ORCHESTRATOR_CREW_MAX_PARALLEL=8

# ── Evaluation: LLM-as-judge sampling ─────────────────────────────────────
# Judge scoring is nondeterministic: each case is scored k times and the
# median gates. EVAL_JUDGE_MAX_PARALLEL caps judge calls in flight.
# EVAL_JUDGE_SAMPLES=3
# EVAL_JUDGE_MAX_PARALLEL=4

# ── Orchestrator: indirect-injection scan on tool output (KILL SWITCH) ────
# Every tool observation is scanned for zero-width/bidi/HTML-comment
# smuggling at the universal chokepoint (react + parallel executors) and
# wrapped in <untrusted_tool_output>. The scan is ON by default; set this to
# 0/false/no/off only where byte-exact tool output is required.
# BASELITH_INDIRECT_SCAN_TOOL_OUTPUT=false

# ── Optimizer: eval gate on automated prompt tuning (opt-in) ──────────────
# With the gate on, auto_tune applies a candidate prompt only after it
# passes the tune evaluator, landing it as a versioned registry candidate.
# Fail closed: gate on + no evaluator = no application.
# BASELITH_OPTIMIZER_EVAL_GATE=true

# ── Guardrails: LLM input taxonomy (opt-in) ───────────────────────────────
# Third inbound layer after regex + moderation: cheap LLM classification
# {in_scope, out_of_scope, jailbreak, harmful} + confidence; blocks
# jailbreak/harmful (and out_of_scope when GuardrailsConfig.allowed_topics
# is set programmatically). Fails open on LLM errors.
# BASELITH_INPUT_GUARD_TAXONOMY=true
# BASELITH_INPUT_GUARD_TAXONOMY_THRESHOLD=0.8

# ── Guardrails: synchronous output groundedness (opt-in) ──────────────────
# Judge sourced responses (result carries sources/context) with the
# faithfulness evaluator: annotate adds guardrails.groundedness metadata,
# block swaps ungrounded answers (< threshold) for a refusal-to-assert.
# BASELITH_OUTPUT_GROUNDEDNESS=off   # off | annotate | block
# BASELITH_OUTPUT_GROUNDEDNESS_THRESHOLD=0.6

# ── Sandbox: compute metering ─────────────────────────────────────────────
# SANDBOX_COST_PER_COMPUTE_SECOND=0.0
# Egress for untrusted sandboxed code (bridge network); off = network_mode none
# SANDBOX_ENABLE_NETWORK=false

# ── Sandbox: base image ───────────────────────────────────────────────────
# The sandbox image is built from the bundled Dockerfile.sandbox. If that file
# is missing the sandbox refuses to start rather than silently substituting an
# unreviewed public image. To allow a different base, enable it AND pin the
# image by digest — a tag can change between review and execution.
# SANDBOX_ALLOW_UNHARDENED_BASE=false
# SANDBOX_UNHARDENED_BASE_IMAGE=

# ── Webhooks: durable store ───────────────────────────────────────────────
# memory = process-local (lost on restart, invisible to the worker);
# postgres = migration 011 tables, secrets encrypted with DATA_ENCRYPTION_KEYS.
# WEBHOOK_STORE=memory

# ── Skills: catalog BM25 pre-filter ───────────────────────────────────────
# Past the threshold, a query-aware render includes only the top-K
# relevant skills (LLM-in-prompt selection degrades past ~50 skills).
# BASELITH_SKILL_CATALOG_PREFILTER_THRESHOLD=50
# BASELITH_SKILL_CATALOG_PREFILTER_TOP_K=25

# ── Baselithbot: realtime voice (opt-in) ──────────────────────────────────
# Full-duplex voice with barge-in over the OpenAI Realtime API (replaces
# the sequential wake→STT→LLM→TTS pipeline when enabled). API key reuses
# VOICE_OPENAI_API_KEY / OPENAI_API_KEY.
# BASELITHBOT_VOICE_REALTIME_ENABLED=true
# BASELITHBOT_VOICE_REALTIME_MODEL=gpt-4o-realtime-preview
# BASELITHBOT_VOICE_REALTIME_VOICE=alloy
# BASELITHBOT_VOICE_REALTIME_SILENCE_DURATION_MS=500
# BASELITHBOT_VOICE_REALTIME_LATENCY_BUDGET_MS=500

# ── Vision: native audio model ────────────────────────────────────────────
# OpenAI model used by VisionService.analyze_audio (gpt-4o cannot take
# input_audio parts). PDFs reuse the per-provider vision models.
# VISION_OPENAI_AUDIO_MODEL=gpt-4o-audio-preview

# ── Baselithbot: post-write verification ──────────────────────────────────
# Compile-check every .py file the agent writes via fs_write and append the
# outcome to the tool result (the error IS the feedback loop). Default ON.
# BASELITH_POST_WRITE_VERIFY=true

# ── MCP: declarative external servers ─────────────────────────────────────
# MCP_SERVERS='{"weather": {"command": "python", "args": ["weather_server.py"], "autonomy_category": "read_only"}}'

# ── MCP: tool-call limits ─────────────────────────────────────────────────
# Server-side deadline on one tools/call handler (0 disables), and the cap on
# the serialized result — a larger result is truncated with a notice rather
# than refused (0 disables).
# MCP_TOOL_CALL_TIMEOUT_SECONDS=60
# MCP_MAX_TOOL_RESULT_BYTES=1048576

# ── MCP: token audience binding (RFC 8707) ────────────────────────────────
# Canonical resource identifier for the MCP endpoint: what the RFC 9728
# metadata publishes AND what a token's `aud` is checked against. Unset, it is
# derived from the request's Host header — set it to the public URL whenever a
# proxy fronts the app and ALLOWED_HOSTS is not pinned.
# MCP_RESOURCE_URL=https://api.example.com/mcp
#
# Enforce the audience check. Unset resolves to the runtime posture (on in
# production, off elsewhere). With it on, a token whose `aud` names a different
# resource is refused, and so is a token with no `aud`. Set it to false to
# stand the check down — the escape hatch for a deployment whose JWT_AUDIENCE
# is not this endpoint's resource URL (every token would mismatch).
# MCP_REQUIRE_TOKEN_AUDIENCE=true

# ── Swarm: handoff cycle guard ────────────────────────────────────────────
# BASELITH_HANDOFF_CYCLE_GUARD=0

# ── AP2 mandates: signed-condition enforcement ────────────────────────────
# verify_chain enforces IntentMandate.conditions (allowed_merchants,
# max_items, allowed_skus; unknown keys fail closed). Kill-switch:
# BASELITH_AP2_ENFORCE_CONDITIONS=0

# ── Orchestrator: cross-replica run events ────────────────────────────────
# With 2+ replicas, route run events (GET /runs/{id}/events SSE) through
# Redis pub/sub so any replica can serve any run's feed. Off = per-process
# fan-out (single replica only). Failure degrades to per-process.
# BASELITH_RUN_EVENTS_BRIDGE=redis

# ── Guardrails: content moderation ────────────────────────────────────────
# Off unless a provider is named. 'openai' = OpenAI moderation API (free),
# keyed from OPENAI_API_KEY / LLM_API_KEY (LLM_PROVIDER=openai). Fail-open:
# a moderation outage degrades to unmoderated service, never a chat outage.
# BASELITH_MODERATION_PROVIDER=openai
# Output-side moderation (final responses + streamed output, checked every
# 512 chars): a second opt-in on top of the provider — one extra call per
# response. Already-streamed text cannot be recalled.
# BASELITH_MODERATION_OUTPUT=true

# ── Observability: OpenInference enrichment (Phoenix/Arize) ───────────────
# Adds OpenInference attributes to the existing LLM spans, so the OTLP
# exporter can feed an LLM-observability backend directly. Content capture
# (prompt/completion text, truncated to 4096 chars) is a separate opt-in —
# prompts routinely carry user PII.
# BASELITH_OPENINFERENCE_ENABLED=true
# BASELITH_OPENINFERENCE_CAPTURE_CONTENT=true

# ── Quotas: tenant USD cost budgets ───────────────────────────────────────
# QUOTAS_ENABLED=true). Distinct from the per-run LoopBudget USD cap.
# QUOTA_TENANT_DAILY_COST_USD=
# QUOTA_TENANT_MONTHLY_COST_USD=
# QUOTA_IDENTITY_DAILY_COST_USD=
# QUOTA_IDENTITY_MONTHLY_COST_USD=
# How to price a call to a model absent from the pricing table: charge
# (default, bills UNKNOWN_PRICE) | zero | reject.
# BASELITH_UNKNOWN_MODEL_COST_POLICY=charge

# ── Tokens: exact Claude counting (opt-in) ────────────────────────────────
# Use anthropic.Anthropic().messages.count_tokens (async only, thread-
# offloaded) for claude* models instead of the tiktoken/heuristic estimate.
# ANTHROPIC_API_KEY alone does NOT enable this — it is a blocking network
# call per estimate, so it must be turned on explicitly.
# BASELITH_EXACT_TOKEN_COUNTING=true

# ── Prompts: per-prompt A/B experiments ───────────────────────────────────
# Weighted variant selection for a catalog prompt, stable per subject
# (ambient tenant by default). Format: "<version>:<weight>,...".
# BASELITH_PROMPT_VARIANTS_REACT_SYSTEM=1:50,2:50

# ── Prompts: durable catalog (cross-replica promotion) ────────────────────
# Write-through Postgres backend + per-replica refresh loop: label
# promotions via the /prompts admin API reach every replica. Off = prompts
# stay replica-local (the admin write endpoints refuse with 503).
# BASELITH_PROMPT_SYNC=postgres
# BASELITH_PROMPT_SYNC_INTERVAL=30

# ── Guardrails: PII engine ────────────────────────────────────────────────
# NER-based redaction (names, addresses) replacing the regex pass; needs
# `pip install baselith-core[pii]`. Unset = regex redaction (now including
# EU patterns: IBAN, Italian codice fiscale).
# BASELITH_PII_ENGINE=presidio

# ── Anthropic serving backend ─────────────────────────────────────────────
# 'api' (default) uses ANTHROPIC_API_KEY. 'bedrock'/'vertex' use the SDK's
# native cloud clients (AWS SigV4 / Google ADC) — no Anthropic key needed;
# region/project fall back to AWS_REGION / GOOGLE_CLOUD_PROJECT+CLOUD_ML_REGION.
# LLM_ANTHROPIC_BACKEND=bedrock
# LLM_ANTHROPIC_AWS_REGION=eu-west-1
# LLM_ANTHROPIC_VERTEX_PROJECT=
# LLM_ANTHROPIC_VERTEX_REGION=

# ── Postgres ──────────────────────────────────────────────────────────────
# Whether a store may run its own CREATE TABLE on the shared pool at first use.
# Unset = decide from the environment: allowed outside production, refused when
# APP_ENV=production, where the migrations Job owns the schema and the runtime
# DB_RUNTIME_DDL=true
RATE_LIMIT_FAIL_MODE=open
DB_HOST=localhost
DB_PASSWORD=__CHANGE_ME__
DB_SSL_MODE=require
DB_POOL_MAX_SIZE=10

# ── Graph DB ──────────────────────────────────────────────────────────────
GRAPH_QUERY_LIMIT=100
GRAPH_QUERY_TIMEOUT=10

# ── Cache / Queue (Redis) ─────────────────────────────────────────────────
CACHE_BACKEND=redis
CACHE_REDIS_URL=redis://localhost:6379/1
QUEUE_REDIS_URL=redis://localhost:6379/2
# XFetch probabilistic early refresh (cache-stampede prevention): as an entry
# nears expiry one caller treats a hit as a miss and recomputes before the TTL
# lapses, so the herd never meets a synchronised cold key. 1.0 is the canonical
# value and the default; 0 disables; >1 recomputes earlier, <1 later.
BASELITH_CACHE_XFETCH_BETA=1.0

# ── Document ingestion ────────────────────────────────────────────────────
DOCUMENTS_EXTENSIONS=pdf,docx,txt,md
DOCUMENTS_PDF_READER=auto
DOCLING_TARGET_CHUNK_TOKENS=240
DOCLING_CONTEXT_TOKENS=520
WEB_DOCUMENTS_URLS=
WEB_DOCUMENTS_MAX_PAGES=50
WEB_DOCUMENTS_RENDER_TIMEOUT=30
WEB_DOCUMENTS_USER_AGENT=baselith-core/1.0
WEB_DOCUMENTS_ALLOWLIST=
ENABLE_SPACY_DOCUMENTS=false
SPACY_FALLBACK_LANGUAGE=en

# ── OCR ───────────────────────────────────────────────────────────────────
MINERU_SERVER_URL=
# Model download source: huggingface | modelscope | local (empty = auto)
MINERU_MODEL_SOURCE=

# ── Logging / Telemetry ───────────────────────────────────────────────────
LOG_LEVEL_FILE=DEBUG
# Directory for the JSON file sink (app.log). Empty ⇒ CWD-relative "logs/".
# Pin an ABSOLUTE path so the sink does not depend on the process working dir
# and lands on a writable, log-shipper-mounted volume (a Promtail scrape path,
# or a systemd ReadWritePaths dir under ProtectSystem=strict).
#   BASELITH_LOG_DIR=/var/log/baselithcore
BASELITH_LOG_DIR=
TELEMETRY_ENABLED=true
# OTLP wire protocol: grpc (default, port 4317) or http/protobuf (port 4318).
# Pick http/protobuf for a collector's otlphttp receiver, for a vendor ingest
# endpoint, or behind any L7 proxy that will not forward HTTP/2 trailers; the
# per-signal /v1/traces|metrics|logs path is appended for you. The standard
# OTEL_EXPORTER_OTLP_PROTOCOL is accepted as an alias.
#   TELEMETRY_OTEL_PROTOCOL=http/protobuf
#   TELEMETRY_OTEL_ENDPOINT=http://localhost:4318
# Ship log records to the collector over OTLP as well as to stdout. The log
# lines already carry trace_id/span_id; this hands the backend those fields
# structured instead of leaving them to be re-parsed out of a scraped file.
# TELEMETRY_LOGS_ENABLED=false
# With WEB_CONCURRENCY>1 set PROMETHEUS_MULTIPROC_DIR (an existing writable
# dir, e.g. /tmp/prometheus) so /metrics aggregates across uvicorn workers.
#   PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
APP_TIMEZONE=UTC
# Sampling: the standard OTel variables are honoured and win over
# TELEMETRY_TRACES_SAMPLE_RATE. Names: always_on, always_off, traceidratio,
# parentbased_always_on, parentbased_always_off, parentbased_traceidratio.
#   OTEL_TRACES_SAMPLER=parentbased_traceidratio
#   OTEL_TRACES_SAMPLER_ARG=0.1
# Tenants broken out individually on tenant-labelled metrics (comma-separated).
# Everything else collapses to "other"; empty (default) collapses all of them,
# which is what keeps per-tenant cost from multiplying every series.
# METRICS_TENANT_LABEL_ALLOWLIST=
# Attach the active trace_id to histogram observations (OpenMetrics exemplars),
# so a latency bucket in Grafana links to the trace that produced it.
# METRICS_EXEMPLARS_ENABLED=true

# ── Features ──────────────────────────────────────────────────────────────
# FEEDBACK_SUMMARY_CACHE_TTL=60
# LLM_MAX_CONCURRENT_REQUESTS=0
CHAT_MEMORY_ENABLED=true
# Long-term AgentMemory for the orchestrator (embedding + store round-trip per request)
# CHAT_LONG_TERM_MEMORY_ENABLED=false
CHAT_MEMORY_MAX_TURNS=10
# CHAT_GUARDRAILS_* configure only the opt-in core/chat RAG pipeline
# (RagWorkflowHandler); the guards every request runs read GUARDRAILS_*.
CHAT_GUARDRAILS_BLOCK_MESSAGE=Content blocked by guardrails.
CHAT_GUARDRAILS_OUT_OF_SCOPE_MESSAGE=Out-of-scope request rejected.
# Topical rail for the live input guard: set to let the LLM taxonomy rule a
# query out_of_scope. Extra block regexes are comma-separated.
# GUARDRAILS_ALLOWED_TOPICS=questions about the indexed product documentation
# GUARDRAILS_CUSTOM_BLOCK_PATTERNS=
# GUARDRAILS_MAX_INPUT_LENGTH=10000

# ── Supermemory (optional intelligent memory backend) ─────────────────────
# SUPERMEMORY_ENABLED=false
# SUPERMEMORY_API_KEY=
# SUPERMEMORY_BASE_URL=
# SUPERMEMORY_DEFAULT_TAG=baselithcore_default
# SUPERMEMORY_SEARCH_LIMIT=5
# SUPERMEMORY_MIN_SCORE=0.0
# Per-request timeout (seconds) and SDK retry budget: without a timeout an
# unresponsive endpoint would stall memory operations indefinitely.
# SUPERMEMORY_TIMEOUT_SECONDS=10.0
# SUPERMEMORY_MAX_RETRIES=2

# ── Plugins ───────────────────────────────────────────────────────────────
PLUGIN_CONFIG_PATH=./configs/plugins.yaml
# Marketplace hub used by `baselith plugin marketplace ...` and the Backstage
# publish flow (PluginConfig.OFFICIAL_MARKETPLACE_URL).
# PLUGIN_OFFICIAL_MARKETPLACE_URL=https://marketplace.baselithcore.xyz

# ── Swarm ─────────────────────────────────────────────────────────────────
# Threads in the dedicated model-inference pool (embedding, cross-encoder
# reranking). Kept separate from the interpreter default pool so a burst of
# inference cannot starve the short latency-critical tasks that share it —
# SSRF DNS resolution, audit-log appends, tokenization. Small on purpose: the
# inference libraries parallelise internally, so extra threads buy contention
# rather than throughput. Unset = min(4, cpu_count // 2).
BASELITH_INFERENCE_THREADS=

# ── Browser agent ─────────────────────────────────────────────────────────
# Lifetime of a cached per-host SSRF verdict. A cached verdict is a decision
# taken from a PAST DNS answer, so its lifetime is exactly the DNS-rebinding
# window; verdicts are also dropped on every top-level navigation, but that
# alone never expires them on a single-page app. 0 disables caching entirely
# (strictest: every request re-resolves, at one DNS lookup per sub-resource).
# NOTE: the in-process guard cannot close the rebinding window — Chromium
# resolves independently of this check. Route the browser through an
# egress-filtering proxy, or run it in a network namespace that denies
# internal ranges, if you need that guarantee.
BASELITH_BROWSER_SSRF_CACHE_TTL=30
# Escape hatch for trusted local development ONLY: allows the browser to reach
# loopback/private/link-local hosts.
BASELITH_BROWSER_ALLOW_INTERNAL=false

# ── Tree-of-Thoughts ──────────────────────────────────────────────────────
TOT_MAX_DEPTH=4
TOT_THOUGHT_CACHE_TTL=3600

# ── Resilience ────────────────────────────────────────────────────────────
RESILIENCE_CB_HALF_OPEN_MAX=3
RESILIENCE_RETRY_BASE_DELAY=0.5
RESILIENCE_RETRY_MAX_DELAY=10

# ── Auth / Security ───────────────────────────────────────────────────────
SECRET_KEY=__CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32__
ALLOW_ORIGINS=https://app.example.com
# Host allowlist. Empty (the default) means TrustedHostMiddleware is NOT
# mounted and the Host header goes unvalidated — a spoofed Host then poisons
# absolute URLs built from the request (reset / verification links) and
# host-keyed caches. Production logs an ERROR at startup while this is empty.
TRUSTED_HOSTS=["app.example.com"]
API_KEYS_USER=__CHANGE_ME__
API_KEYS_ADMIN=__CHANGE_ME__
API_KEYS_JOB=__CHANGE_ME__
# Least-privilege scoped keys: "key1=chat:read|chat:write,key2=webhooks:write".
# API_KEYS_SCOPED=
# Prefer the PBKDF2-SHA256 digest over the plain password (see
# docs/advanced/security.md). 'password' / 'changeme' / 'admin' are refused.
# ADMIN_USER=admin
ADMIN_PASS=__CHANGE_ME__
# ADMIN_PASS_HASHED=
# Token binding: derived from APP_BASE_URL when unset; set to pin explicitly.
# JWT_ISSUER=
# JWT_AUDIENCE=
# AUTH_ACCESS_TOKEN_LIFETIME=3600
# Signing algorithm and key ring. HS256 (default) signs and verifies with
# SECRET_KEY alone. JWT_KEYS ("kid1=key1,kid2=key2") holds several keys at
# once, which is what makes rotation non-disruptive: add the new key, point
# JWT_ACTIVE_KID at it, drop the old one after the longest token lifetime.
# An asymmetric choice (EdDSA/RS256/ES256) additionally needs JWT_SIGNING_KEY
# (private) and lets a verify-only service hold the public JWT_KEYS without
# being able to mint. JWT_STRICT_VALIDATION (reject tokens missing aud/iss)
# switches itself on once issuer+audience are set under AUTH_REQUIRED.
# JWT_ALGORITHM=HS256
# JWT_KEYS=
# JWT_ACTIVE_KID=
# JWT_SIGNING_KEY=
# JWT_STRICT_VALIDATION=false
# Second factor (TOTP, RFC 6238); MFA_ISSUER is the label in the
# authenticator app. Off by default, purely additive.
# MFA_ENABLED=false
# MFA_ISSUER=BaselithCore
# Federated SSO (OIDC): bearer tokens that are not local tokens are verified
# against the provider's JWKS (discovered from the issuer when the URL is
# unset). OIDC_ROLE_MAP maps IdP roles to app roles: "okta-admins:admin".
# OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_ALGORITHMS=RS256
# OIDC_USERNAME_CLAIM=sub
# OIDC_ROLES_CLAIM=roles
# OIDC_SCOPES_CLAIM=scope
# OIDC_TENANT_CLAIM=
# OIDC_DEFAULT_ROLE=user
# OIDC_ROLE_MAP=
# Where credentials are read from: env (default) or file — SECRETS_DIR then
# holds one file per secret, the way Docker and Kubernetes mount them.
# SECRETS_BACKEND=env
# SECRETS_DIR=
# Application-level encryption at rest: "kid:secret,kid2:secret2" plus the id
# that encrypts NEW data; older ids stay readable, which is how a key rotates.
# Empty (the default) leaves field encryption off.
# DATA_ENCRYPTION_KEYS=
# DATA_ENCRYPTION_ACTIVE_KEY_ID=
# When Redis is unreachable in production, admin lockout fails CLOSED (503 on
# privileged auth) so an attacker cannot lift the brute-force throttle by
# taking the counter down; true prefers availability.
# BASELITH_LOCKOUT_FAIL_OPEN=false
# Reverse-proxy trust for uvicorn (--forwarded-allow-ips): IPs/CIDRs whose
# X-Forwarded-For / -Proto are honoured. Set it to your LB / ingress address
# or per-IP rate limits, the failed-auth throttle and the admin lockout all
# collapse into ONE bucket shared by every client.
# FORWARDED_ALLOW_IPS=127.0.0.1
# uvicorn runtime (all three entry points — container CMD, `python
# backend.py`, `baselith run` — read the same three). Keep the keep-alive
# LONGER than your proxy's upstream idle timeout (nginx/ALB/Envoy: 60s) or
# it reuses sockets the app already closed and surfaces sporadic 502s. The
# drain must stay BELOW the orchestrator's termination grace (k8s: 30s
# default, 45s in the Helm chart). UVICORN_LIMIT_CONCURRENCY is load
# shedding: above that many concurrent connections uvicorn answers 503 at
# once instead of queueing until something times out; unset = no limit.
# UVICORN_KEEP_ALIVE=75
# GRACEFUL_SHUTDOWN_TIMEOUT=30
# UVICORN_LIMIT_CONCURRENCY=
# Idempotency-Key replay (IdempotencyMiddleware): on by default, credential-
# scoped, fail-open without Redis. TTL is an upper bound (bearer replays are
# also capped by the token's exp); bodies over the cap stream through
# uncached; anonymous replay is off because credential-less callers would
# share one bucket (see docs/advanced/runtime-tuning.md).
# BASELITH_IDEMPOTENCY_ENABLED=true
# BASELITH_IDEMPOTENCY_TTL_SECONDS=86400
# BASELITH_IDEMPOTENCY_MAX_BODY_BYTES=1048576
# BASELITH_IDEMPOTENCY_ALLOW_ANONYMOUS=false
# Perimeter limits (code defaults): per-role request budgets per window, the
# per-IP budget of FAILED auth attempts, the request body cap (bytes, 0
# disables), the limiter's behaviour without Redis (open|closed; unset =
# closed in production with CACHE_BACKEND=redis) and admin auth on /metrics.
# RATE_LIMIT_USER_PER_MINUTE=60
# RATE_LIMIT_ADMIN_PER_MINUTE=120
# RATE_LIMIT_JOB_PER_MINUTE=
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_FAIL_MODE=
# AUTH_FAILURE_LIMIT_PER_MINUTE=20
# What an unreadable API-key revocation denylist (Redis) means: closed (the
# default) rejects the key, so a key revoked on another worker stays revoked
# through an outage; open accepts it on process-local state, which un-revokes
# every such key for the duration.
# API_KEY_REVOCATION_FAIL_MODE=closed
# MAX_REQUEST_SIZE_BYTES=10485760
# The cap above guards every JSON endpoint. A streaming-upload route that
# legitimately takes more (a plugin's document intake, say) does NOT need it
# raised: the route's owner registers its own cap for its path prefix with
# core.middleware.security.register_request_size_override(prefix, max_bytes),
# so the default keeps protecting everything else.
# METRICS_AUTH_REQUIRED=true
# Security headers (SecurityHeadersMiddleware): CSP/Permissions-Policy/HSTS
# and the cross-origin pair are emitted only while the master switch is on;
# an EMPTY value omits that header. Values below are the code defaults.
# SECURITY_HEADERS_ENABLED=true
# CONTENT_SECURITY_POLICY=
# PERMISSIONS_POLICY=geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
# CROSS_ORIGIN_OPENER_POLICY=same-origin-allow-popups
# CROSS_ORIGIN_RESOURCE_POLICY=same-origin
# ENABLE_HSTS=true
# HSTS_MAX_AGE=31536000
# X_FRAME_OPTIONS=DENY
SENTRY_DSN=
# Plugin integrity: NEVER enable in production
BASELITH_SKIP_INTEGRITY_CHECK=false
# Reject any plugin that does not declare an integrity hash.
BASELITH_REQUIRE_SIGNED_PLUGINS=false
# Publisher authenticity: refuse plugins whose integrity hash is not Ed25519-
# signed by a trust root. Sign with scripts/sign_plugin_ed25519.py; generate
# keys with `python scripts/sign_plugin_ed25519.py keygen`.
BASELITH_REQUIRE_PLUGIN_SIGNATURES=false
# Comma-separated hex Ed25519 public keys trusted to sign plugins. Legacy form:
# no key identity, no expiry, no way to revoke. Prefer the trust store below.
BASELITH_PLUGIN_TRUST_ROOTS=
# Path to a JSON trust store: {"keys": [{"key_id", "public_key_hex",
# "not_after", "revoked"}]}. Merged with the roots above, and a store entry for
# the same key wins — so revoking or expiring a key takes effect even while it
# is still listed there. Revoked and expired keys never verify a signature.
BASELITH_PLUGIN_TRUST_STORE=
# Declared plugin capabilities (manifest `permissions:` block): off | warn |
# enforce. `warn` logs a call outside the declared set and lets it through —
# the observation window. `enforce` holds a plugin to what it declared; one
# that declared NOTHING is never refused, so enabling this cannot brick
# plugins written before the block existed. Egress, tools and secrets are
# enforced; `filesystem` is documentation only.
BASELITH_PLUGIN_PERMISSIONS=warn
# Plugin admission gates, both fail-closed. A plugin whose declared
# min/max_core_version or plugin_dependencies are unsatisfied (COMPAT), or
# whose config violates its own declared JSON Schema (CONFIG), is skipped.
# Set to false only as a temporary downgrade to warn-only while a manifest is
# being corrected.
BASELITH_ENFORCE_PLUGIN_COMPAT=true
BASELITH_ENFORCE_PLUGIN_CONFIG=true
# Installed distributions may publish plugins through the `baselith.plugins`
# entry-point group; the plugins/ directory still wins on a name clash. Set to
# true to consider only the plugins/ directory and ignore every installed
# package.
BASELITH_DISABLE_PLUGIN_ENTRY_POINTS=false
# Seconds teardown waits for a plugin's cancelled background tasks to unwind
# before abandoning them with a warning. The wait is bounded because the
# registry holds its lock across unregister and a task may swallow
# CancelledError — a stuck plugin must never freeze the registry. 0 = cancel
# and do not wait.
BASELITH_PLUGIN_TASK_CANCEL_TIMEOUT=10
# Workflow definitions are pinned to a durable run: off | warn | enforce.
# `enforce` (the default) fails a resume whose definition changed while the
# run was in flight, instead of replaying recorded outputs into an edited
# graph. A run started before this existed carries no pin and is never
# refused, which is what makes the default safe.
BASELITH_WORKFLOW_VERSION_PINNING=enforce

# ── Agent-to-Agent (A2A) ──────────────────────────────────────────────────
# HMAC-sign A2A traffic: set the SAME secret on every peer of the mesh. When
# set, requests with a missing/invalid/stale signature are rejected with 401.
BASELITH_A2A_SHARED_SECRET=
# Optional per-peer identity: sender declares (and MAC-binds) X-A2A-Peer and
# signs with ITS OWN secret; the verifier resolves it from the map below.
# A leaked secret then exposes one identity, not the whole mesh.
# BASELITH_A2A_PEER_ID=
# BASELITH_A2A_PEER_SECRETS=peerA=secretA,peerB=secretB
# With no shared secret the A2A dispatch endpoint FAILS CLOSED in production
# (unsigned requests -> 401). Set true ONLY to explicitly allow unauthenticated
# A2A in production (trusted network). No effect outside production.
BASELITH_A2A_ALLOW_UNAUTHENTICATED=false
# Per-source-IP budget on POST /a2a, metered before signature verification with
# the same limiter the HTTP API uses (429 + Retry-After once exhausted).
# Default 120/min; 0 disables.
BASELITH_A2A_RATE_LIMIT_PER_MINUTE=120
# Maximum accepted JSON-RPC request body on POST /a2a (413 above it). The body
# is buffered to verify the signature over the exact bytes, so this bounds the
# read. Default 1 MiB; 0 disables.
BASELITH_A2A_MAX_BODY_BYTES=1048576
# Whether the SSRF guard lets A2A reach private/loopback/link-local peers.
# Unset, the default is environment-aware: allowed in development (meshes
# commonly run peers on internal networks) but DENIED in production, so a peer
# endpoint cannot be steered at cloud metadata (169.254.169.254), Redis or
# Postgres. Setting it overrides in both directions — true to opt a
# private-mesh production deployment back in, false to lock down a dev box.
A2A_ALLOW_INTERNAL_ENDPOINTS=

# ── Backstage catalog / TechDocs source resolution ────────────────────────
# The Backstage exporter advertises each plugin's docs via a techdocs-ref in
# ONE of two modes. Pick the one that matches your deploy topology.
#
# GIT mode (default): the exporter emits an "url:" ref under this base, and the
# portal's TechDocs generator fetches the plugin's mkdocs from the git host.
# The public repo below needs no token; a PRIVATE fork would need a GITHUB_TOKEN
# integration in the portal app-config AND the docs pushed to the referenced
# branch — otherwise the Docs tab 404s (api.github.com/repos/.../status 404).
BASELITH_CATALOG_SOURCE_LOCATION=url:https://github.com/baselithcore/baselithcore/blob/main/
#
# LOCAL mode (self-hosted single-host deploy where the framework backend and the
# portal share the repo filesystem): set this to the ABSOLUTE repo root on that
# host. The exporter then emits "techdocs-ref: dir:." + a "file:" location, so
# the portal's generator builds docs straight from local disk — no git host,
# token or push needed. Leave EMPTY to stay in git mode above.
#   BASELITH_CATALOG_LOCAL_ROOT=/opt/baselithcore
BASELITH_CATALOG_LOCAL_ROOT=

# ── Audit trail: keyed hash chain ─────────────────────────────────────────
# The audit chain is only tamper-evident against an attacker if they cannot
# recompute it. Without a key it is a plain SHA-256 chain: anyone who can write
# to the audit database can rebuild every link and the trail verifies again.
# Set a secret here (and rotate at a chain boundary — rotating invalidates
# verification of rows written under the previous key).
# AUDIT_CHAIN_HMAC_KEY=
# Refuse to open the durable audit sink without that key. Turn this on wherever
# the audit trail is evidence rather than telemetry.
# AUDIT_CHAIN_REQUIRE_KEY=false

# ── Task queue: dead letter ───────────────────────────────────────────────
# How long a terminally-failed job stays in the DLQ. 0 keeps records forever
# (and the Redis keyspace with them).
# TASK_QUEUE_DLQ_RETENTION_SECONDS=604800
# Module prefixes a dead-lettered job may be replayed from (comma-separated).
# A DLQ row is data read back out of Redis and RQ imports whatever dotted path
# it is handed, so a row naming `os.system` would otherwise be one replay click
# from running. Anything outside these prefixes is refused before any import.
# An empty value refuses every replay.
# TASK_QUEUE_DLQ_REPLAY_ALLOWED_MODULES=core.,plugins.
