# Digest-pinned, same base and same digest as the root Dockerfile: this
# image runs agent-supplied code, so "whatever `python:3.12-slim` means
# today" is not a good enough answer about what is inside it. Refresh it
# together with the root Dockerfile's pin, which carries the Trivy check
# a candidate digest has to pass.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Data Science libraries
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    scikit-learn

# Create a non-root user for security
RUN useradd -m -u 1000 sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["python"]
