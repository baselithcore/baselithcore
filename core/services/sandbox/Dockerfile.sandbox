# Digest-pinned, same base and same digest as the root Dockerfile: this
# image runs agent-supplied code, so "whatever `python:3.12-slim` means
# today" is not a good enough answer about what is inside it. Refresh it
# together with the root Dockerfile's pin, which carries the Trivy check
# a candidate digest has to pass.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Data Science libraries.
# Version-pinned, like the base image above: this image is built on the host
# the first time a sandbox is needed, so an unpinned set means two machines run
# agent code against two different library versions, and a build months from
# now is a different sandbox from the one that was reviewed. Resolved together
# for Python 3.12, so the four move as a set.
RUN pip install --no-cache-dir \
    numpy==2.5.3 \
    pandas==3.0.6 \
    matplotlib==3.11.2 \
    scikit-learn==1.9.1

# Create a non-root user for security
RUN useradd -m -u 1000 sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["python"]
