# =============================================================================
# Base Configuration - Baselith-Core (White-Label)
# =============================================================================
# This file contains shared settings used across all environments.
# Copy and customize for your deployment (e.g., cp configs/.env.base .env).
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings (CORE_ prefix)
# -----------------------------------------------------------------------------
CORE_APP_NAME=Baselith-Core
CORE_DEBUG=false
CORE_DATA_DIR=data
CORE_DETERMINISTIC_MODE=false
CORE_RANDOM_SEED=42

# -----------------------------------------------------------------------------
# LLM Settings (LLM_ prefix)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama                # ollama, openai, huggingface, anthropic, gemini
# Always set LLM_PROVIDER explicitly: unset, it inherits the package default
# above and every request is served by a local model on this host.
# LLM_PREFLIGHT=auto                 # auto|warn|strict|off — startup posture check
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=
LLM_API_KEY=                      # API key for provider (e.g. OpenAI)
LLM_API_BASE=                      # Base URL for API (e.g. for Ollama)
LLM_ENABLE_CACHE=true
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# HuggingFace Settings (within LLMConfig)
# -----------------------------------------------------------------------------
LLM_HUGGINGFACE_LOCAL=false        # Use local transformers instead of Inference API
LLM_HUGGINGFACE_DEVICE=auto        # auto, cpu, cuda, mps
LLM_HUGGINGFACE_DTYPE=auto         # auto, float16, bfloat16, float32
LLM_HUGGINGFACE_TRUST_REMOTE_CODE=false
HF_TOKEN=                          # Required for some private models

# -----------------------------------------------------------------------------
# Vision Service (VISION_ prefix)
# -----------------------------------------------------------------------------
VISION_PROVIDER=openai             # openai, anthropic, google, ollama
VISION_OPENAI_API_KEY=
VISION_ANTHROPIC_API_KEY=
VISION_GOOGLE_API_KEY=
VISION_OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------------
# Voice Service (VOICE_ prefix)
# -----------------------------------------------------------------------------
VOICE_PROVIDER=openai              # openai, elevenlabs, google
VOICE_OPENAI_API_KEY=
VOICE_ELEVENLABS_API_KEY=
VOICE_GOOGLE_API_KEY=
VOICE_GOOGLE_APPLICATION_CREDENTIALS=
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Fine-Tuning Service (FINETUNE_ prefix)
# -----------------------------------------------------------------------------
FINETUNE_OPENAI_API_KEY=
FINETUNE_TOGETHER_API_KEY=

# -----------------------------------------------------------------------------
# VectorStore Settings (VECTORSTORE_ prefix)
# -----------------------------------------------------------------------------
VECTORSTORE_PROVIDER=qdrant
VECTORSTORE_COLLECTION_NAME=documents
VECTORSTORE_QDRANT_HOST=localhost
VECTORSTORE_PORT=6333
VECTORSTORE_GRPC_PORT=6334
VECTORSTORE_EMBEDDING_MODEL=BAAI/bge-m3
VECTORSTORE_EMBEDDING_DIM=1024
EMBEDDING_CACHE_TTL=3600
VECTORSTORE_SEARCH_LIMIT=10
VECTORSTORE_QDRANT_MODE=server
EMBEDDING_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Chat Service (CHAT_ prefix)
# -----------------------------------------------------------------------------
CHAT_STREAMING_ENABLED=true
CHAT_INITIAL_SEARCH_K=20
CHAT_FINAL_TOP_K=5
CHAT_ENABLE_RERANKING=true
CHAT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHAT_RERANK_MAX_CANDIDATES=50
CHAT_ENABLE_RESPONSE_CACHE=true
CHAT_RESPONSE_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Storage & Databases (Postgres, GraphDB, Redis)
# -----------------------------------------------------------------------------
POSTGRES_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baselithcore
DB_USER=baselithcore
# Set a real password before use. Do not ship this placeholder to any shared
# or production environment (docker-compose reads the same value for Postgres).
DB_PASSWORD=__CHANGE_ME__
# Plaintext locally; require TLS for any non-local Postgres (see prod compose).
DB_SSL_MODE=disable
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=30.0
# false behind PgBouncer in transaction pooling mode (< 1.21 or without
# max_prepared_statements): psycopg's server-side prepared statements break.
# DB_PREPARED_STATEMENTS=true

GRAPH_DB_ENABLED=true
GRAPH_DB_URL=redis://localhost:6379
GRAPH_DB_NAME=agent_graph
GRAPH_RAG_ENABLED=false
GRAPH_DB_TIMEOUT=2.0
GRAPH_SIMILAR_TOP_K=5
GRAPH_CACHE_TTL=3600
GRAPH_QUERY_LIMIT=30
GRAPH_MAX_HOPS=3

CACHE_BACKEND=local               # local, redis
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_REDIS_PREFIX=baselithcore
QUEUE_REDIS_URL=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Processing (OCR, Web, NLP)
# -----------------------------------------------------------------------------
DOCUMENTS_EXTENSIONS='[".md", ".markdown", ".pdf", ".docx", ".doc", ".xlsx", ".xls", ".pptx", ".ppt", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".tif", ".tiff"]'
DOCUMENTS_PDF_READER=auto          # auto, pypdf, docling
DOCLING_TARGET_CHUNK_TOKENS=240
DOCLING_CONTEXT_TOKENS=520
WEB_DOCUMENTS_ENABLED=false
WEB_DOCUMENTS_URLS='[]'
WEB_DOCUMENTS_MAX_PAGES=5
WEB_DOCUMENTS_MAX_DEPTH=2
WEB_DOCUMENTS_RENDER_TIMEOUT=20.0
WEB_DOCUMENTS_USER_AGENT="Mozilla/5.0..."
WEB_DOCUMENTS_ALLOWLIST='[]'
ENABLE_SPACY_DOCUMENTS=true
SPACY_MODEL=en_core_web_sm
SPACY_FALLBACK_LANGUAGE=
# OCR backend. 'chandra' was removed; a config carrying it is migrated to
# 'mineru' at startup with a deprecation warning, so do not reintroduce it.
PDF_OCR_BACKEND=mineru             # mineru, tesseract, auto
# MinerU model download source. Blank means 'auto'.
MINERU_MODEL_SOURCE=

# Logging
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=INFO
LOG_JSON=true
LOG_MASKING_ENABLED=true

# Telemetry
TELEMETRY_ENABLED=false
TELEMETRY_OTEL_ENDPOINT=http://localhost:4317
# Head sampling ratio (0.0-1.0). Unset: 1.0 outside production, 0.1 when
# APP_ENV/ENVIRONMENT is production. Set it to override either way.
# TELEMETRY_TRACES_SAMPLE_RATE=

APP_TIMEZONE=Europe/Rome
ENABLE_FEEDBACK=true
LLM_BUDGET_ENABLED=true
LLM_BUDGET_MAX_TOKENS=10000

CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_MAX_TURNS=6
CHAT_MEMORY_SUMMARY_ENABLED=true

CHAT_GUARDRAILS_ENABLED=true
CHAT_GUARDRAILS_BLOCK_MESSAGE="I cannot assist you with this request."
CHAT_GUARDRAILS_OUT_OF_SCOPE_MESSAGE="I can only answer questions related to the indexed documents."

# -----------------------------------------------------------------------------
# Plugin System (PLUGIN_ prefix)
# -----------------------------------------------------------------------------
PLUGIN_ENABLED=true
PLUGIN_AUTO_LOAD=true
PLUGIN_CONFIG_PATH=configs/plugins.yaml

# -----------------------------------------------------------------------------
# Sandbox Service (SANDBOX_ prefix)
# -----------------------------------------------------------------------------
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=30
SANDBOX_ENABLE_NETWORK=false
# SANDBOX_DOCKER_SOCKET=/var/run/docker.sock

# -----------------------------------------------------------------------------
# Advanced Reasoning - Tree of Thoughts (TOT_ prefix)
# -----------------------------------------------------------------------------
TOT_MAX_DEPTH=3
TOT_BRANCHING_FACTOR=3
TOT_BEAM_WIDTH=3
TOT_STRATEGY=bfs                   # bfs, dfs

# Self-correction
TOT_SELF_CORRECTION_MAX_ITERATIONS=2

# Thought Cache
TOT_THOUGHT_CACHE_MAXSIZE=1000
TOT_THOUGHT_CACHE_TTL=1800.0

# -----------------------------------------------------------------------------
# Resilience (RESILIENCE_ prefix)
# -----------------------------------------------------------------------------
# Circuit Breaker
RESILIENCE_CB_FAIL_MAX=5
RESILIENCE_CB_RESET_TIMEOUT=60
RESILIENCE_CB_HALF_OPEN_MAX=1

# Retry
RESILIENCE_RETRY_MAX_ATTEMPTS=3
RESILIENCE_RETRY_BASE_DELAY=1.0
RESILIENCE_RETRY_MAX_DELAY=60.0
RESILIENCE_RETRY_EXPONENTIAL_BASE=2.0
RESILIENCE_RETRY_JITTER=true

# Bulkhead
RESILIENCE_BULKHEAD_MAX_CONCURRENT=10

# -----------------------------------------------------------------------------
# Security & Auth
# -----------------------------------------------------------------------------
# Same values as the code defaults (core/config/security.py): auth on, no
# cross-origin browser access. AUTH_REQUIRED=true refuses to start without a
# SECRET_KEY of 32+ characters — generate one with `openssl rand -hex 32`.
# To relax on a local, loopback-only dev box, start from
# configs/.env.development instead (AUTH_REQUIRED=false, ALLOW_ORIGINS=["*"]),
# or set just those two lines here; never ship either to a reachable host.
AUTH_REQUIRED=true
SECRET_KEY=
ALLOW_ORIGINS=[]
API_KEYS_USER=[]
API_KEYS_ADMIN=[]
API_KEYS_JOB=[]
# Master switch for API-key auth. When false, API keys are rejected entirely.
API_KEY_ENABLED=true

ADMIN_USER=admin
# Left EMPTY on purpose: SecurityConfig refuses the placeholder values
# 'password' / 'changeme' / 'admin' at startup (and refuses ANY admin password
# next to ALLOW_ORIGINS=["*"]), so a template carrying one crashed the
# app the moment it was copied to .env. Empty disables the Basic-auth admin
# console until you set a real value — or, better, ADMIN_PASS_HASHED
# (PBKDF2-SHA256; see docs/advanced/security.md) together with a concrete
# ALLOW_ORIGINS list.
ADMIN_PASS=
ADMIN_PASS_HASHED=

# Host allowlist (TrustedHostMiddleware). Empty leaves the Host header
# unvalidated; production refuses to start while this is empty, unless
# BASELITH_ALLOW_UNVALIDATED_HOST=true downgrades that to an ERROR log.
TRUSTED_HOSTS=[]

# Least-privilege scoped keys: "key1=chat:read|chat:write,key2=webhooks:write".
API_KEYS_SCOPED=

# Token binding: derived from APP_BASE_URL when unset; set explicitly to pin.
JWT_ISSUER=
JWT_AUDIENCE=
AUTH_ACCESS_TOKEN_LIFETIME=3600

# Signing algorithm and key ring. HS256 (default) signs and verifies with
# SECRET_KEY alone. JWT_KEYS ("kid1=key1,kid2=key2") holds several keys at once
# so a rotation never invalidates a session: add the new key, point
# JWT_ACTIVE_KID at it, drop the old one after the longest token lifetime. An
# asymmetric algorithm (EdDSA/RS256/ES256) additionally needs JWT_SIGNING_KEY
# (private) and lets a verify-only service hold the public ring without being
# able to mint. The three key fields are commented out rather than left empty:
# an empty ring is not "unset". JWT_STRICT_VALIDATION switches itself on once
# issuer+audience are set under AUTH_REQUIRED.
JWT_ALGORITHM=HS256
# JWT_KEYS=
# JWT_ACTIVE_KID=
# JWT_SIGNING_KEY=
JWT_STRICT_VALIDATION=false

# Second factor (TOTP, RFC 6238); the issuer is the label in the authenticator
# app. Off by default, purely additive.
MFA_ENABLED=false
MFA_ISSUER=BaselithCore

# Federated SSO (OIDC): bearer tokens that are not local tokens are verified
# against the provider's JWKS (discovered from the issuer when the URL is
# unset). Provider-specific values are commented out rather than left empty;
# OIDC_ROLE_MAP maps IdP roles to app roles ("okta-admins:admin").
OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_USERNAME_CLAIM=sub
OIDC_ROLES_CLAIM=roles
OIDC_SCOPES_CLAIM=scope
# OIDC_TENANT_CLAIM=
OIDC_DEFAULT_ROLE=user
# OIDC_ROLE_MAP=

# Where credentials are read from: env (default) or file — SECRETS_DIR then
# holds one file per secret, the way Docker and Kubernetes mount them.
SECRETS_BACKEND=env
# SECRETS_DIR=

# Application-level encryption at rest: "kid:secret,kid2:secret2" plus the id
# that encrypts NEW data; older ids stay readable, which is how a key rotates.
# Commented out (unset) leaves field encryption off.
# DATA_ENCRYPTION_KEYS=
# DATA_ENCRYPTION_ACTIVE_KEY_ID=

# When Redis is unreachable in production, admin lockout fails CLOSED (503 on
# privileged auth) so an attacker cannot lift the brute-force throttle by
# taking the counter down; true prefers availability.
BASELITH_LOCKOUT_FAIL_OPEN=false

# Perimeter limits (code defaults). Per-role request budgets per window, the
# per-IP budget of FAILED auth attempts (brute-force throttle), the request
# body cap (bytes, 0 disables) and whether GET /metrics demands admin auth.
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=120
# Commented out rather than left empty: an empty string is not "unset" for an
# int / open|closed field — pydantic rejects it and the app refuses to boot.
# RATE_LIMIT_JOB_PER_MINUTE=
RATE_LIMIT_WINDOW_SECONDS=60
# open | closed — what the limiter does when Redis is unreachable. Unset
# resolves to closed in production with CACHE_BACKEND=redis, open otherwise.
# RATE_LIMIT_FAIL_MODE=
AUTH_FAILURE_LIMIT_PER_MINUTE=20
MAX_REQUEST_SIZE_BYTES=10485760
METRICS_AUTH_REQUIRED=true

# Security headers (SecurityHeadersMiddleware). Values below are the code
# defaults; CSP/Permissions-Policy/HSTS and the cross-origin pair are emitted
# only while SECURITY_HEADERS_ENABLED=true. An EMPTY CROSS_ORIGIN_* value omits
# that header (use same-site on CORP for split api/app subdomains).
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=
CROSS_ORIGIN_OPENER_POLICY=same-origin-allow-popups
CROSS_ORIGIN_RESOURCE_POLICY=same-origin
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
X_FRAME_OPTIONS=DENY
# Browser features the console never needs; "" omits the header.
PERMISSIONS_POLICY=geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

# Reverse-proxy trust for uvicorn (--forwarded-allow-ips): IPs/CIDRs whose
# X-Forwarded-For / -Proto are honoured. Set to your LB / ingress address so
# per-IP rate limits and the admin lockout see the real client.
FORWARDED_ALLOW_IPS=127.0.0.1

# uvicorn runtime — the container CMD, `python backend.py` and `baselith run`
# all read the same three. Keep the keep-alive LONGER than the proxy's
# upstream idle timeout (nginx/ALB/Envoy: 60s) or it reuses sockets the app
# already closed (sporadic 502s); keep the drain BELOW the orchestrator's
# termination grace (k8s default 30s, Helm chart 45s). UVICORN_LIMIT_CONCURRENCY
# is load shedding — 503 at once above that many concurrent connections
# instead of queueing until something times out; commented out = no limit
# (an empty value is not "unset" for an int).
UVICORN_KEEP_ALIVE=75
GRACEFUL_SHUTDOWN_TIMEOUT=30
# UVICORN_LIMIT_CONCURRENCY=

# Idempotency-Key replay (IdempotencyMiddleware): on by default, credential-
# scoped, fail-open without Redis. The TTL is an upper bound (bearer replays
# are also capped by the token's exp); bodies over the cap stream through
# uncached; anonymous replay stays off because credential-less callers would
# share one bucket (see docs/advanced/runtime-tuning.md).
BASELITH_IDEMPOTENCY_ENABLED=true
BASELITH_IDEMPOTENCY_TTL_SECONDS=86400
BASELITH_IDEMPOTENCY_MAX_BODY_BYTES=1048576
BASELITH_IDEMPOTENCY_ALLOW_ANONYMOUS=false

# Plugin integrity (never skip in production).
BASELITH_SKIP_INTEGRITY_CHECK=false
BASELITH_REQUIRE_SIGNED_PLUGINS=false

# Agent-to-Agent (A2A): set the SAME shared secret on all mesh peers to enable
# HMAC signing. With no secret, A2A dispatch fails closed in production unless
# BASELITH_A2A_ALLOW_UNAUTHENTICATED=true (no effect outside production).
BASELITH_A2A_SHARED_SECRET=
BASELITH_A2A_ALLOW_UNAUTHENTICATED=false

# -----------------------------------------------------------------------------
# Supermemory — Intelligent Memory Layer (SUPERMEMORY_ prefix)
# Opt-in. Set SUPERMEMORY_ENABLED=true and provide an API key to activate.
# API keys: https://console.supermemory.ai
# Docs: https://docs.baselithcore.xyz/core-modules/supermemory/
# -----------------------------------------------------------------------------
SUPERMEMORY_ENABLED=false
SUPERMEMORY_API_KEY=                   # Required when enabled
SUPERMEMORY_BASE_URL=                  # Leave empty for Supermemory Cloud; set for self-hosted
SUPERMEMORY_DEFAULT_TAG=baselithcore_default
SUPERMEMORY_SEARCH_LIMIT=5
SUPERMEMORY_MIN_SCORE=0.0

# -----------------------------------------------------------------------------
# Baselithbot — Browser/Computer-Use plugin (BASELITHBOT_ prefix)
# Plugin is opt-in via configs/plugins.yaml (baselithbot.enabled).
# All vars below are OPTIONAL but RECOMMENDED in production.
# Docs: plugins/baselithbot/docs/
# -----------------------------------------------------------------------------
# Bearer token gate for the dashboard write endpoints (PUT/POST/DELETE).
# When unset, write endpoints are UNGUARDED — never run that way over a
# network. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BASELITHBOT_DASHBOARD_TOKEN=

# Fernet master key encrypting provider API keys at rest. When unset, a
# new key is generated on first boot and persisted to
# plugins/baselithbot/.state/.secret_key (mode 0600). For multi-node
# deployments lift it into this env var instead.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BASELITHBOT_SECRET_KEY=

# SSRF guard opt-out: every outbound HTTP call baselithbot makes (channel
# webhooks, integrations, skills, the Ollama model probe) rejects
# loopback/private/link-local/metadata destinations by default. Set to
# true only for trusted local setups that legitimately target an internal
# host (a LAN Matrix homeserver, a localhost Ollama instance).
BASELITHBOT_ALLOW_INTERNAL_WEBHOOKS=false

# -----------------------------------------------------------------------------
# Added in the 2026-09 modernisation pass
# -----------------------------------------------------------------------------
# Every value below is the shipped default, left commented out so copying this
# file changes no behaviour. Uncomment only what you intend to move. Grouped by
# the subsystem they bind, not by prefix — read the group comment before the
# knob: several of these trade safety for reach and are fail-closed on purpose.

# ── Vector store: pgvector HNSW tuning (VECTORSTORE_PROVIDER=pgvector) ───────
# m and ef_construction are baked into the index at CREATE time; raising them
# on a populated collection requires dropping and rebuilding it. ef_search is a
# per-query knob applied as SET LOCAL; 0 leaves the server default alone.
# VECTORSTORE_HNSW_M=16
# VECTORSTORE_HNSW_EF_CONSTRUCTION=64
# VECTORSTORE_HNSW_EF_SEARCH=40
# Filtered searches keep scanning until LIMIT matches (pgvector >= 0.8):
# off | strict_order | relaxed_order.
# VECTORSTORE_HNSW_ITERATIVE_SCAN=strict_order
# Record gen_ai.usage.input_tokens on embedding spans. Off by default: it costs
# a second tokenizer pass over every text that misses the embedding cache.
# VECTORSTORE_EMBEDDING_TOKEN_USAGE_ENABLED=false

# ── Chat: streaming deadline ────────────────────────────────────────────────
# Wall-clock cap on one POST /chat/stream SSE response. A hung provider
# otherwise holds the connection — and the worker slot behind it — open
# indefinitely; on expiry the stream closes with its terminal `event: done`.
# Keep it below the reverse proxy's read timeout.
# CHAT_STREAM_TIMEOUT_SECONDS=300

# ── Orchestrator: per-request runtime caps ──────────────────────────────────
# Ceilings every orchestrated run inherits. 0 disables an individual cap.
# ORCHESTRATOR_LOOP_MAX_TOKENS=400000
# ORCHESTRATOR_LOOP_MAX_SECONDS=600
# Denominator of token_pressure() when no token cap is set, so context
# auto-tuning still has a signal.
# ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=200000
# Maximum crew tasks run concurrently under process='parallel'. Each is a full
# LLM call, so an unbounded fan-out is a 429 storm plus an unmetered cost spike.
# ORCHESTRATOR_CREW_MAX_PARALLEL=8

# ── Orchestrator: background crash-recovery sweeps ──────────────────────────
# Active only with ORCHESTRATOR_CHECKPOINT_RESUME_ON_STARTUP=true.
# ORCHESTRATOR_RECOVERY_SWEEP_INTERVAL_SECONDS=300
# How long a 'running' run must be silent before a sweep re-enters it. Recent
# progress means a worker still owns it and resuming would run the same agent
# loop twice. Keep at or above the sweep interval.
# ORCHESTRATOR_RECOVERY_RESUME_AFTER_SECONDS=300
# ORCHESTRATOR_RECOVERY_STALE_AFTER_SECONDS=1800

# ── Human-in-the-loop: callback thread pool ─────────────────────────────────
# Worker threads for blocking HITL callbacks. A dedicated pool, never the
# interpreter default one: a callback waits on a person, and a timed-out one
# never returns its thread.
# ORCHESTRATOR_HITL_CALLBACK_THREADS=8

# ── MCP server: tool-call limits and token audience ─────────────────────────
# Server-side deadline on one tools/call handler. 0 disables it.
# MCP_TOOL_CALL_TIMEOUT_SECONDS=60
# Cap on the serialized size of one tools/call result; a larger result is
# truncated with an explicit notice. 0 disables the cap. Any other value must
# be >= 512: the truncation notice and its _meta envelope alone cost ~220-240
# bytes, so a smaller cap cannot be honoured.
# MCP_MAX_TOOL_RESULT_BYTES=1048576
# Canonical resource identifier for this MCP endpoint (RFC 8707 / RFC 9728).
# Unset, it is derived from the request's Host header — which a caller controls
# when no host allowlist is pinned. Set it to the public URL in production.
# MCP_RESOURCE_URL=
# Require an OAuth access token to name this endpoint in its `aud` claim.
# Unset resolves at request time: enforced in production, off elsewhere.
# MCP_REQUIRE_TOKEN_AUDIENCE=

# ── Observability: metric cardinality and trace exemplars ───────────────────
# Attach the current trace_id to histogram observations as an OpenMetrics
# exemplar, linking a latency bucket to the trace behind it. Served only to a
# scraper that requests application/openmetrics-text.
# METRICS_EXEMPLARS_ENABLED=true
# Tenant ids broken out individually on tenant-labelled metrics; every other
# tenant collapses to 'other'. Empty collapses all of them (one extra series).
# METRICS_TENANT_LABEL_ALLOWLIST=

# ── Audit trail: hash-chain integrity ───────────────────────────────────────
# HMAC-SHA256 key for the audit hash chain. Unset falls back to a plain SHA-256
# chain, which detects accidents but not an attacker who can rewrite the log.
# AUDIT_CHAIN_HMAC_KEY=
# Refuse to start the durable audit sink without that key. Turn it on wherever
# the audit trail is evidence rather than telemetry.
# AUDIT_CHAIN_REQUIRE_KEY=false

# ── API keys: revocation-check failure mode ─────────────────────────────────
# What to do when the revocation store cannot be reached: 'closed' rejects the
# request, 'open' accepts it. Leave closed unless availability genuinely
# outranks the risk of honouring a revoked key.
# API_KEY_REVOCATION_FAIL_MODE=closed

# ── Task queue: dead-letter retention and replay ────────────────────────────
# TASK_QUEUE_DLQ_RETENTION_SECONDS=604800
# Module prefixes a dead-lettered job may be replayed into, checked before
# anything is imported. A DLQ record carries a caller-supplied dotted path and
# RQ imports whatever it is handed ('os.system' is a well-formed path), so
# widening this is widening remote code execution. Empty refuses every replay.
# TASK_QUEUE_DLQ_REPLAY_ALLOWED_MODULES=core.,plugins.

# ── Evaluation: LLM-as-a-judge sampling ─────────────────────────────────────
# Judge evaluations per case; the median score gates.
# EVAL_JUDGE_SAMPLES=3
# Judge calls in flight at once across the suite.
# EVAL_JUDGE_MAX_PARALLEL=4

# ── Sandbox: base image policy ──────────────────────────────────────────────
# Permit falling back to an external base image when the bundled hardened
# sandbox Dockerfile is missing. Requires the digest-pinned image below; tags
# are rejected outright.
# SANDBOX_ALLOW_UNHARDENED_BASE=false
# SANDBOX_UNHARDENED_BASE_IMAGE=

# ── Plugins: load gates and supply chain ────────────────────────────────────
# Path to the JSON trust store of publisher keys for Ed25519 plugin
# signatures ({"keys": [{key_id, public_key_hex, not_after, revoked}]}).
# Unset means no trust roots — with signature enforcement on, every plugin is
# refused, which is the fail-closed outcome.
# BASELITH_PLUGIN_TRUST_STORE=
# Refuse to load a plugin whose declared config does not validate.
# BASELITH_ENFORCE_PLUGIN_CONFIG=true
# Refuse to load a plugin whose min_core_version does not match this core.
# BASELITH_ENFORCE_PLUGIN_COMPAT=true
# Ignore third-party plugins advertised through Python entry points. Set true
# where only the plugins on disk may load.
# BASELITH_DISABLE_PLUGIN_ENTRY_POINTS=false
# Seconds teardown waits for a plugin's cancelled tasks to unwind. 0 does not
# wait at all.
# BASELITH_PLUGIN_TASK_CANCEL_TIMEOUT=10.0

# ── Model cost and token accounting ─────────────────────────────────────────
# Count tokens with the provider's own counting API instead of an estimate.
# Exact, but adds a round trip per request.
# BASELITH_EXACT_TOKEN_COUNTING=false
# How to price a call to a model absent from the pricing table: 'charge' bills
# UNKNOWN_PRICE so the gap stays visible in cost dashboards, 'zero' treats the
# call as free (a self-hosted model with no USD cost), 'reject' raises instead
