{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {"type": "fix", "release": "patch"},
          {"type": "feat", "release": "minor"},
          {"type": "perf", "release": "patch"},
          {"type": "refactor", "release": false},
          {"type": "docs", "release": false},
          {"type": "chore", "release": false},
          {"type": "ci", "release": false},
          {"type": "test", "release": false}
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here. This file is\nmaintained automatically by semantic-release from Conventional Commits and\nfollows [Keep a Changelog](https://keepachangelog.com) and\n[Semantic Versioning](https://semver.org)."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python - <<'PY'\nimport re\nfrom pathlib import Path\nversion = \"${nextRelease.version}\"\nminor = \".\".join(version.split(\".\")[:2])\nPath('core/_version.py').write_text('\"\"\"Single source of truth for the framework version.\"\"\"\\n\\n__version__ = \"' + version + '\"\\n', encoding='utf-8')\n# The Helm chart's appVersion IS the image tag a plain `helm install` pulls\n# (image.tag defaults to empty). Rewriting only core/_version.py left the\n# chart a release behind, silently deploying the previous image.\nchart = Path('deploy/helm/baselithcore/Chart.yaml')\nchart.write_text(re.sub(r'^appVersion: \".*\"$', 'appVersion: \"' + version + '\"', chart.read_text(encoding='utf-8'), count=1, flags=re.M), encoding='utf-8')\n# SECURITY.md's \"Supported Versions\" table is a promise to operators about\n# which minor still receives fixes. Hand-maintained, it drifted three minors\n# behind and told them a release we no longer patch was the supported one.\nsec = Path('SECURITY.md')\ntext = sec.read_text(encoding='utf-8')\ntext = re.sub(r'^\\|\\s*[0-9][^|]*\\|\\s*:white_check_mark:\\s*\\|$', '| ' + minor + '.x  | :white_check_mark: |', text, count=1, flags=re.M)\ntext = re.sub(r'^\\|\\s*<[^|]*\\|\\s*:x:\\s*\\|$', '| < ' + minor + '  | :x:                |', text, count=1, flags=re.M)\nsec.write_text(text, encoding='utf-8')\n# The two client SDKs ship against this release's API surface, so they carry\n# its version. Left at a hand-written 0.1.0 they said nothing at all: the\n# Python __version__, the npm package version and the TS User-Agent constant\n# (baselith-sdk-ts/<VERSION>, which is what shows up in a server's logs) were\n# all frozen while the server they talk to moved through thirty minors.\nsdk_py = Path('sdk/python/baselith_sdk/version.py')\nsdk_py.write_text(re.sub(r'^__version__ = \".*\"$', '__version__ = \"' + version + '\"', sdk_py.read_text(encoding='utf-8'), count=1, flags=re.M), encoding='utf-8')\npkg = Path('sdk/typescript/package.json')\npkg.write_text(re.sub(r'\"version\": \"[^\"]*\"', '\"version\": \"' + version + '\"', pkg.read_text(encoding='utf-8'), count=1), encoding='utf-8')\nts = Path('sdk/typescript/src/client.ts')\nts.write_text(re.sub(r\"^const VERSION = '[^']*';$\", \"const VERSION = '\" + version + \"';\", ts.read_text(encoding='utf-8'), count=1, flags=re.M), encoding='utf-8')\nPY"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "core/_version.py",
          "CHANGELOG.md",
          "deploy/helm/baselithcore/Chart.yaml",
          "SECURITY.md",
          "sdk/python/baselith_sdk/version.py",
          "sdk/typescript/package.json",
          "sdk/typescript/src/client.ts"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
