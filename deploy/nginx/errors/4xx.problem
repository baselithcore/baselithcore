{"type": "urn:baselith:error:edge_rejected", "title": "<!--# if expr="$status = 413" -->Request body too large<!--# else -->Too many requests<!--# endif -->", "status": <!--# echo var="status" default="429" -->, "detail": "<!--# if expr="$status = 413" -->The request body exceeds the gateway's limit (client_max_body_size, equal to the application's MAX_REQUEST_SIZE_BYTES). Split the upload or raise both limits together.<!--# else -->The edge rate limit for your client address was exceeded. Slow down and retry with backoff.<!--# endif -->"}
