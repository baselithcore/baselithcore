{
  "name": "agent_parallel_tools",
  "description": "Agent.run: two tool calls in ONE assistant turn are answered by ONE user message carrying both tool_result blocks, in call order.",
  "turns": [
    {
      "expect": {
        "prompt_contains": ["Look both up at once"],
        "tools": ["get_order", "get_shipment"],
        "roles": ["user"]
      },
      "result": {
        "text": null,
        "tool_calls": [
          {
            "id": "par_1",
            "name": "get_order",
            "arguments": {
              "order_id": 42
            }
          },
          {
            "id": "par_2",
            "name": "get_shipment",
            "arguments": {
              "shipment_id": "SHP-7"
            }
          }
        ],
        "stop_reason": "tool_use",
        "tokens_used": 94
      }
    },
    {
      "expect": {
        "tools": ["get_order", "get_shipment"],
        "roles": ["user", "assistant", "user"],
        "tool_results": [
          {
            "tool_use_id": "par_1",
            "contains": ["{\"order_id\": 42, \"shipment_id\": \"SHP-7\"}"],
            "is_error": false
          },
          {
            "tool_use_id": "par_2",
            "contains": ["in transit, ETA 2 days"],
            "is_error": false
          }
        ],
        "envelope": true
      },
      "result": {
        "text": "Order 42 is on shipment SHP-7, in transit, ETA 2 days.",
        "tool_calls": [],
        "stop_reason": "end_turn",
        "tokens_used": 128
      }
    }
  ]
}
