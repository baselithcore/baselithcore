{
  "name": "agent_multi_tool_order",
  "description": "Agent.run: two sequential tool calls; the history is append-only, so every later turn still carries every earlier tool_use/tool_result pair.",
  "turns": [
    {
      "expect": {
        "prompt_contains": ["order 42"],
        "tools": ["get_order", "get_shipment"],
        "roles": ["user"]
      },
      "result": {
        "text": null,
        "tool_calls": [
          {
            "id": "call_1",
            "name": "get_order",
            "arguments": {
              "order_id": 42
            }
          }
        ],
        "stop_reason": "tool_use",
        "tokens_used": 88
      }
    },
    {
      "expect": {
        "tools": ["get_order", "get_shipment"],
        "roles": ["user", "assistant", "user"],
        "tool_results": [
          {
            "tool_use_id": "call_1",
            "contains": ["{\"order_id\": 42, \"shipment_id\": \"SHP-7\"}"],
            "is_error": false
          }
        ],
        "envelope": true
      },
      "result": {
        "text": null,
        "tool_calls": [
          {
            "id": "call_2",
            "name": "get_shipment",
            "arguments": {
              "shipment_id": "SHP-7"
            }
          }
        ],
        "stop_reason": "tool_use",
        "tokens_used": 102
      }
    },
    {
      "expect": {
        "prompt_contains": [
          "order 42",
          "[tool_result call_1]",
          "{\"order_id\": 42, \"shipment_id\": \"SHP-7\"}"
        ],
        "tools": ["get_order", "get_shipment"],
        "roles": ["user", "assistant", "user", "assistant", "user"],
        "tool_results": [
          {
            "tool_use_id": "call_2",
            "contains": ["in transit, ETA 2 days"],
            "is_error": false
          }
        ],
        "envelope": true
      },
      "result": {
        "text": "Order 42 shipped as SHP-7 and is in transit, ETA 2 days.",
        "tool_calls": [],
        "stop_reason": "end_turn",
        "tokens_used": 130
      }
    }
  ]
}
