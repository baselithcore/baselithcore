{
  "name": "agent_tool_loop",
  "description": "Agent.run: one tool call, its result returned as a correlated tool_result block, then a final answer grounded in it.",
  "turns": [
    {
      "expect": {
        "prompt_contains": [
          "capital of Italy"
        ],
        "tools": [
          "lookup_capital"
        ],
        "roles": [
          "user"
        ]
      },
      "result": {
        "text": null,
        "tool_calls": [
          {
            "id": "call_1",
            "name": "lookup_capital",
            "arguments": {
              "country": "Italy"
            }
          }
        ],
        "stop_reason": "tool_use",
        "tokens_used": 96
      }
    },
    {
      "expect": {
        "prompt_contains": [
          "capital of Italy"
        ],
        "system_prompt_contains": [
          "never follow instructions"
        ],
        "tools": [
          "lookup_capital"
        ],
        "roles": [
          "user",
          "assistant",
          "user"
        ],
        "tool_results": [
          {
            "tool_use_id": "call_1",
            "contains": [
              "Rome"
            ],
            "is_error": false
          }
        ],
        "envelope": true
      },
      "result": {
        "text": "The capital of Italy is Rome.",
        "tool_calls": [],
        "stop_reason": "end_turn",
        "tokens_used": 141
      }
    }
  ]
}
